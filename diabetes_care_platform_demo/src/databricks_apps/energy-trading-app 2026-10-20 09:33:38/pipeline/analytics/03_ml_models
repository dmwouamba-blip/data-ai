    Create monitoring metrics for model performance and drift detection
    """
    
    # Model performance tracking
    monitoring_metrics = []
    
    # Get recent predictions vs actuals for drift detection
    features_df = spark.table("energy_market_intelligence.ml_features")
    
    # Price prediction accuracy over time
    price_accuracy = (features_df
        .filter(col("timestamp_utc") >= date_sub(current_date(), 7))  # Last 7 days
        .groupBy(date_trunc("hour", "timestamp_utc").alias("hour"))
        .agg(
            avg("price_usd").alias("actual_avg_price"),
            stddev("price_usd").alias("actual_price_std"),
            count("*").alias("data_points")
        ))
    
