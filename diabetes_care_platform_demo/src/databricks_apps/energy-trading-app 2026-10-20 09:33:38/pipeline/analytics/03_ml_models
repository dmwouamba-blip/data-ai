def train_arbitrage_detection_model():
    """
    Train a classification model to detect high-probability arbitrage opportunities
    """
    
    with mlflow.start_run(run_name="arbitrage_detection_model"):
        
        # Prepare training data
        arbitrage_df = spark.table("energy_market_intelligence.silver_arbitrage_opportunities")
        
        # Create labels (1 = high opportunity, 0 = low opportunity)
        training_df = (arbitrage_df
            .withColumn("high_opportunity", 
                when((col("opportunity_score") > 0.7) & (col("profit_potential") > 500), 1)
                .otherwise(0))
            
            # Add time-based features
            .withColumn("hour_of_day", hour("timestamp"))
            .withColumn("day_of_week", dayofweek("timestamp"))
            .withColumn("is_peak_hour", when(col("hour_of_day").between(8, 20), 1).otherwise(0))
            
            # Encode categorical features
            .withColumn("market_buy_encoded", 
                when(col("market_buy") == "epex_spot", 1)
                .when(col("market_buy") == "ice_endex", 2)
                .when(col("market_buy") == "nord_pool", 3)
                .when(col("market_buy") == "pjm", 4)
                .otherwise(5))
            
            .withColumn("market_sell_encoded", 
                when(col("market_sell") == "epex_spot", 1)
                .when(col("market_sell") == "ice_endex", 2)
                .when(col("market_sell") == "nord_pool", 3)
                .when(col("market_sell") == "pjm", 4)
                .otherwise(5))
        )
        
        # Feature selection
        feature_cols = [
            "spread", "confidence_score", "volume_potential", "roi_percentage",
            "hour_of_day", "day_of_week", "is_peak_hour", 
            "market_buy_encoded", "market_sell_encoded", "time_since_detection"
        ]
        
        # Create feature vector
        assembler = VectorAssembler(inputCols=feature_cols, outputCol="features")
        
        # Create ML pipeline
        rf_classifier = RandomForestClassifier(
            featuresCol="features",
            labelCol="high_opportunity",
            numTrees=100,
            maxDepth=10,
            seed=42
        )
        
        pipeline = Pipeline(stages=[assembler, rf_classifier])
        
        # Split data
        train_df, test_df = training_df.randomSplit([0.8, 0.2], seed=42)
        
        # Train model
        model = pipeline.fit(train_df)
        
        # Make predictions
        predictions = model.transform(test_df)
        
        # Evaluate model
        evaluator = BinaryClassificationEvaluator(
            labelCol="high_opportunity",
            rawPredictionCol="rawPrediction",
            metricName="areaUnderROC"
        )
        
        auc = evaluator.evaluate(predictions)
        
        # Calculate additional metrics
        accuracy = predictions.filter(col("prediction") == col("high_opportunity")).count() / predictions.count()
        
        # Log metrics
        mlflow.log_metric("auc", auc)
        mlflow.log_metric("accuracy", accuracy)
        mlflow.log_param("num_trees", 100)
        mlflow.log_param("max_depth", 10)
        
        # Save model
        mlflow.spark.log_model(model, "arbitrage_detection_model")
        
        print(f"Arbitrage Detection Model Performance:")
        print(f"  AUC: {auc:.3f}")
        print(f"  Accuracy: {accuracy:.3f}")
        
        return model

arbitrage_model = train_arbitrage_detection_model()

