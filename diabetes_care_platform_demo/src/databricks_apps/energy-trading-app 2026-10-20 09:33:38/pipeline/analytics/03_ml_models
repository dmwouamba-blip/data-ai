def train_sentiment_analysis_model():
    """
    Train a model to analyze market sentiment from communications
    """
    
    with mlflow.start_run(run_name="sentiment_analysis_model"):
        
        # Prepare communications data
        comm_df = spark.table("energy_market_intelligence.silver_communications")
        
        # Create sentiment features
        sentiment_df = (comm_df
            .withColumn("message_length", length("message"))
            .withColumn("has_urgent_words", 
                when(lower(col("message")).rlike("(urgent|alert|critical|immediate)"), 1).otherwise(0))
            .withColumn("has_price_words", 
                when(lower(col("message")).rlike("(price|cost|expensive|cheap)"), 1).otherwise(0))
            .withColumn("has_volume_words", 
                when(lower(col("message")).rlike("(volume|trade|buy|sell)"), 1).otherwise(0))
            .withColumn("has_volatility_words", 
                when(lower(col("message")).rlike("(volatile|swing|fluctuat|unstable)"), 1).otherwise(0))
            
            # Channel importance weighting
            .withColumn("channel_weight",
                when(col("channel") == "bloomberg_chat", 3)
                .when(col("channel") == "teams", 2)
                .when(col("channel") == "slack", 2)
                .otherwise(1))
            
            # Hub coordination indicator
            .withColumn("hub_numeric",
                when(col("hub") == "geneva", 1)
                .when(col("hub") == "houston", 2)
                .when(col("hub") == "singapore", 3)
                .otherwise(4))
            
            # Target variable: impact prediction
            .withColumn("high_impact", 
                when((col("intelligence_score") > 0.7) | (col("urgency_score") > 0.8), 1)
                .otherwise(0))
        )
        
        # Feature selection
        sentiment_features = [
            "message_length", "has_urgent_words", "has_price_words", 
            "has_volume_words", "has_volatility_words", "channel_weight",
            "hub_numeric", "urgency_score", "relevance_score"
        ]
        
        # Create feature vector
        assembler = VectorAssembler(inputCols=sentiment_features, outputCol="features")
        
        # Create classification pipeline
        lr_classifier = LogisticRegression(
            featuresCol="features",
            labelCol="high_impact",
            maxIter=100,
            regParam=0.01
        )
        
        pipeline = Pipeline(stages=[assembler, lr_classifier])
        
        # Split data
        train_df, test_df = sentiment_df.randomSplit([0.8, 0.2], seed=42)
        
        # Train model
        model = pipeline.fit(train_df)
        
        # Make predictions
        predictions = model.transform(test_df)
        
        # Evaluate model
        evaluator = BinaryClassificationEvaluator(
            labelCol="high_impact",
            rawPredictionCol="rawPrediction",
            metricName="areaUnderROC"
        )
        
        auc = evaluator.evaluate(predictions)
        accuracy = predictions.filter(col("prediction") == col("high_impact")).count() / predictions.count()
        
        # Log metrics
        mlflow.log_metric("auc", auc)
        mlflow.log_metric("accuracy", accuracy)
        mlflow.log_param("max_iter", 100)
        mlflow.log_param("reg_param", 0.01)
        
        # Save model
        mlflow.spark.log_model(model, "sentiment_analysis_model")
        
        print(f"Sentiment Analysis Model Performance:")
        print(f"  AUC: {auc:.3f}")
        print(f"  Accuracy: {accuracy:.3f}")
        
        return model

sentiment_model = train_sentiment_analysis_model()

