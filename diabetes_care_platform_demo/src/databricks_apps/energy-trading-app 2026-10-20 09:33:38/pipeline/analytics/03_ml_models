def register_models():
    """
    Register trained models in MLflow Model Registry
    """
    
    # Get the latest runs for each model
    experiment = mlflow.get_experiment_by_name("/Users/shared/totalenergies-energy-intelligence")
    runs = mlflow.search_runs(experiment_ids=[experiment.experiment_id])
    
    models_to_register = [
        ("arbitrage_detection_model", "Arbitrage Opportunity Detection"),
        ("price_forecasting_model", "Energy Price Forecasting"),
        ("sentiment_analysis_model", "Market Sentiment Analysis"),
        ("anomaly_detection_model", "Market Anomaly Detection")
    ]
    
    for model_name, description in models_to_register:
        try:
            # Find the latest run for this model
            model_runs = runs[runs['tags.mlflow.runName'].str.contains(model_name, na=False)]
            if not model_runs.empty:
                latest_run = model_runs.iloc[0]
                run_id = latest_run['run_id']
                
                # Register model
                model_uri = f"runs:/{run_id}/{model_name}"
                mv = mlflow.register_model(model_uri, f"totalenergies_{model_name}")
                
                # Transition to Production
                client = mlflow.tracking.MlflowClient()
                client.transition_model_version_stage(
                    name=f"totalenergies_{model_name}",
                    version=mv.version,
                    stage="Production"
                )
                
                print(f"✅ Registered {model_name} version {mv.version} to Production")
                
        except Exception as e:
            print(f"❌ Error registering {model_name}: {str(e)}")

# Register models
register_models()

