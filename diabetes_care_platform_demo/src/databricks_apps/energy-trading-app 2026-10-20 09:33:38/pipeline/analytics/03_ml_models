def train_price_forecasting_model():
    """
    Train a regression model for short-term price forecasting
    """
    
    with mlflow.start_run(run_name="price_forecasting_model"):
        
        # Prepare data for price forecasting
        features_df = spark.table("energy_market_intelligence.ml_features")
        
        # Create target variable (next hour price)
        forecast_df = (features_df
            .withColumn("next_price", 
                lead("price_usd").over(
                    Window.partitionBy("market").orderBy("timestamp_utc")))
            .filter(col("next_price").isNotNull())
            .filter(col("price_ma_1h").isNotNull())
        )
        
        # Feature selection for forecasting
        forecast_features = [
            "price_usd", "price_ma_1h", "price_ma_4h", "price_ma_24h",
            "price_std_1h", "price_std_4h", "volume", "volume_ma_1h",
            "market_premium", "global_avg_price", "relative_volume",
            "hour_of_day", "day_of_week", "is_peak_hour", "market_numeric"
        ]
        
        # Create feature vector
        assembler = VectorAssembler(inputCols=forecast_features, outputCol="features")
        
        # Create regression pipeline
        gbtr = GBTRegressor(
            featuresCol="features",
            labelCol="next_price",
            maxIter=100,
            maxDepth=6,
            stepSize=0.1
        )
        
        pipeline = Pipeline(stages=[assembler, gbtr])
        
        # Split data
        train_df, test_df = forecast_df.randomSplit([0.8, 0.2], seed=42)
        
        # Train model
        model = pipeline.fit(train_df)
        
        # Make predictions
        predictions = model.transform(test_df)
        
        # Evaluate model
        evaluator = RegressionEvaluator(
            labelCol="next_price",
            predictionCol="prediction",
            metricName="rmse"
        )
        
        rmse = evaluator.evaluate(predictions)
        
        # Calculate additional metrics
        mae_evaluator = RegressionEvaluator(
            labelCol="next_price",
            predictionCol="prediction",
            metricName="mae"
        )
        mae = mae_evaluator.evaluate(predictions)
        
        r2_evaluator = RegressionEvaluator(
            labelCol="next_price",
            predictionCol="prediction",
            metricName="r2"
        )
        r2 = r2_evaluator.evaluate(predictions)
        
        # Log metrics
        mlflow.log_metric("rmse", rmse)
        mlflow.log_metric("mae", mae)
        mlflow.log_metric("r2", r2)
        mlflow.log_param("max_iter", 100)
        mlflow.log_param("max_depth", 6)
        
        # Save model
        mlflow.spark.log_model(model, "price_forecasting_model")
        
        print(f"Price Forecasting Model Performance:")
        print(f"  RMSE: {rmse:.3f}")
        print(f"  MAE: {mae:.3f}")
        print(f"  R²: {r2:.3f}")
        
        return model

forecasting_model = train_price_forecasting_model()

