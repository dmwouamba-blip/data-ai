def train_anomaly_detection_model():
    """
    Train an unsupervised model to detect market anomalies
    """
    
    with mlflow.start_run(run_name="anomaly_detection_model"):
        
        # Prepare data for anomaly detection
        features_df = spark.table("energy_market_intelligence.ml_features")
        
        # Select features for anomaly detection
        anomaly_features = [
            "price_usd", "volume", "price_change_pct", "volume_change_pct",
            "price_std_1h", "price_std_4h", "market_premium"
        ]
        
        # Create feature vector
        assembler = VectorAssembler(inputCols=anomaly_features, outputCol="features")
        
        # Standardize features
        scaler = StandardScaler(inputCol="features", outputCol="scaled_features")
        
        # K-means clustering for anomaly detection
        kmeans = KMeans(
            featuresCol="scaled_features",
            predictionCol="cluster",
            k=5,
            seed=42
        )
        
        # Create pipeline
        pipeline = Pipeline(stages=[assembler, scaler, kmeans])
        
        # Train model
        model = pipeline.fit(features_df)
        
        # Make predictions
        predictions = model.transform(features_df)
        
        # Calculate anomaly scores (distance from cluster center)
        def calculate_anomaly_score(df):
            """Calculate anomaly score based on distance to cluster center"""
            
            # Get cluster centers
            kmeans_model = model.stages[-1]
            centers = kmeans_model.clusterCenters()
            
            # Calculate distances (this would be implemented with UDFs in production)
            df_with_scores = (df
                .withColumn("anomaly_score", 
                    when(col("cluster") == 0, rand() * 0.3)  # Simulated for demo
                    .when(col("cluster") == 1, rand() * 0.4)
                    .when(col("cluster") == 2, rand() * 0.5)
                    .when(col("cluster") == 3, rand() * 0.6)
                    .otherwise(rand() * 0.8))
                
                .withColumn("is_anomaly", 
                    when(col("anomaly_score") > 0.7, 1).otherwise(0))
            )
            
            return df_with_scores
        
        predictions_scored = calculate_anomaly_score(predictions)
        
        # Evaluate anomaly detection
        total_records = predictions_scored.count()
        anomalies = predictions_scored.filter(col("is_anomaly") == 1).count()
        anomaly_rate = anomalies / total_records
        
        # Log metrics
        mlflow.log_metric("anomaly_rate", anomaly_rate)
        mlflow.log_metric("total_records", total_records)
        mlflow.log_metric("detected_anomalies", anomalies)
        mlflow.log_param("k_clusters", 5)
        
        # Save model
        mlflow.spark.log_model(model, "anomaly_detection_model")
        
        # Save anomaly results
        (predictions_scored
         .write
         .mode("overwrite")
         .saveAsTable("energy_market_intelligence.ml_anomaly_detection"))
        
        print(f"Anomaly Detection Model Performance:")
        print(f"  Total records processed: {total_records:,}")
        print(f"  Anomalies detected: {anomalies:,}")
        print(f"  Anomaly rate: {anomaly_rate:.2%}")
        
        return model

anomaly_model = train_anomaly_detection_model()

