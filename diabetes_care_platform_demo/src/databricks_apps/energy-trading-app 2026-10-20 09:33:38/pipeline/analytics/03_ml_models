def create_feature_engineering_pipeline():
    """
    Create comprehensive feature engineering pipeline for energy market ML
    """
    
    # Load unified market data
    market_df = spark.table("energy_market_intelligence.silver_unified_markets")
    
    # Create comprehensive features
    features_df = (market_df
        # Time-based features
        .withColumn("hour_of_day", hour("timestamp_utc"))
        .withColumn("day_of_week", dayofweek("timestamp_utc"))
        .withColumn("month", month("timestamp_utc"))
        .withColumn("quarter", quarter("timestamp_utc"))
        .withColumn("is_weekend", when(col("day_of_week").isin([1, 7]), 1).otherwise(0))
        .withColumn("is_peak_hour", when(col("hour_of_day").between(8, 20), 1).otherwise(0))
        
        # Price-based features
        .withColumn("price_change", col("price_usd") - lag("price_usd").over(
            Window.partitionBy("market").orderBy("timestamp_utc")))
        .withColumn("price_change_pct", 
            (col("price_usd") - lag("price_usd").over(
                Window.partitionBy("market").orderBy("timestamp_utc"))) / 
            lag("price_usd").over(Window.partitionBy("market").orderBy("timestamp_utc")) * 100)
        
        # Rolling statistics (1 hour, 4 hours, 24 hours)
        .withColumn("price_ma_1h", avg("price_usd").over(
            Window.partitionBy("market").orderBy("timestamp_utc").rowsBetween(-4, 0)))
        .withColumn("price_ma_4h", avg("price_usd").over(
            Window.partitionBy("market").orderBy("timestamp_utc").rowsBetween(-16, 0)))
        .withColumn("price_ma_24h", avg("price_usd").over(
            Window.partitionBy("market").orderBy("timestamp_utc").rowsBetween(-96, 0)))
        
        .withColumn("price_std_1h", stddev("price_usd").over(
            Window.partitionBy("market").orderBy("timestamp_utc").rowsBetween(-4, 0)))
        .withColumn("price_std_4h", stddev("price_usd").over(
            Window.partitionBy("market").orderBy("timestamp_utc").rowsBetween(-16, 0)))
        
        # Volume-based features
        .withColumn("volume_ma_1h", avg("volume").over(
            Window.partitionBy("market").orderBy("timestamp_utc").rowsBetween(-4, 0)))
        .withColumn("volume_change_pct", 
            (col("volume") - lag("volume").over(
                Window.partitionBy("market").orderBy("timestamp_utc"))) / 
            lag("volume").over(Window.partitionBy("market").orderBy("timestamp_utc")) * 100)
        
        # Cross-market features
        .withColumn("price_rank_global", row_number().over(
            Window.partitionBy("timestamp_utc").orderBy(desc("price_usd"))))
        .withColumn("volume_rank_global", row_number().over(
            Window.partitionBy("timestamp_utc").orderBy(desc("volume"))))
        
        # Market-specific indicators
        .withColumn("market_numeric", 
            when(col("market") == "epex_spot", 1)
            .when(col("market") == "ice_endex", 2)
            .when(col("market") == "nord_pool", 3)
            .when(col("market") == "pjm", 4)
            .when(col("market") == "eex", 5)
            .otherwise(0))
        
        .withColumn("trading_session_numeric",
            when(col("trading_session") == "Day", 1)
            .when(col("trading_session") == "Evening", 2)
            .otherwise(3))
    )
    
    # Save feature engineered data
    (features_df
     .write
     .mode("overwrite")
     .saveAsTable("energy_market_intelligence.ml_features"))
    
    print(f"Feature engineering completed: {features_df.count():,} records with enhanced features")
    return features_df

# Create features
features_df = create_feature_engineering_pipeline()

