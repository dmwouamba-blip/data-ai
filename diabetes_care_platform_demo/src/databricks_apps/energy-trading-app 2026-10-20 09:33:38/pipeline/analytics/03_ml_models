def create_real_time_scoring_pipeline():
    """
    Create a real-time scoring pipeline for all models
    """
    
    # Load the latest features
    features_df = spark.table("energy_market_intelligence.ml_features").limit(100)  # Demo with recent data
    
    # Load production models
    arbitrage_model_prod = mlflow.spark.load_model("models:/totalenergies_arbitrage_detection_model/Production")
    forecasting_model_prod = mlflow.spark.load_model("models:/totalenergies_price_forecasting_model/Production")
    
    # Score arbitrage opportunities
    arbitrage_scores = arbitrage_model_prod.transform(
        spark.table("energy_market_intelligence.silver_arbitrage_opportunities")
    )
    
    # Score price forecasts
    price_forecasts = forecasting_model_prod.transform(features_df)
    
    # Create consolidated scoring results
    scoring_results = (price_forecasts
        .select("timestamp_utc", "market", "price_usd", "prediction")
        .withColumnRenamed("prediction", "predicted_price")
        .withColumn("prediction_confidence", 
            1 - abs(col("price_usd") - col("predicted_price")) / col("price_usd"))
        .withColumn("scoring_timestamp", current_timestamp())
    )
    
    # Save scoring results
    (scoring_results
     .write
     .mode("overwrite")
     .saveAsTable("energy_market_intelligence.ml_scoring_results"))
    
    print(f"Real-time scoring completed: {scoring_results.count():,} predictions generated")
    
    return scoring_results

