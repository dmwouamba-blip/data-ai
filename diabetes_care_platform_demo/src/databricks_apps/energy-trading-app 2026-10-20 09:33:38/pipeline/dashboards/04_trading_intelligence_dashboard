                 .filter(col("timestamp") >= date_sub(current_timestamp(), 1))
                 .groupBy("hub", "priority")
                 .count()
                 .toPandas())
    
    if len(hub_data) > 0:
        # Hub performance metrics
        fig_hub = px.bar(
            hub_data,
            x='hub',
            y='total_profit_potential',
