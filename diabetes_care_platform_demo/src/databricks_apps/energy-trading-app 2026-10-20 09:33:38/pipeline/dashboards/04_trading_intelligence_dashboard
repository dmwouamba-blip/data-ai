def create_ml_dashboard():
    """
    Create dashboard showing ML model predictions and performance
    """
    
    # Price forecasting results
    forecast_data = (spark.table("energy_market_intelligence.ml_scoring_results")
                    .filter(col("scoring_timestamp") >= date_sub(current_timestamp(), 1))
                    .toPandas())
    
    if len(forecast_data) > 0:
        # Prediction vs actual prices
        fig_forecast = px.scatter(
            forecast_data,
            x='price_usd',
            y='predicted_price',
            color='market',
            size='prediction_confidence',
            title='ML Price Predictions vs Actual Prices',
            labels={
                'price_usd': 'Actual Price (USD/MWh)',
                'predicted_price': 'Predicted Price (USD/MWh)'
            }
        )
        
        # Add perfect prediction line
        min_price = min(forecast_data['price_usd'].min(), forecast_data['predicted_price'].min())
        max_price = max(forecast_data['price_usd'].max(), forecast_data['predicted_price'].max())
        
        fig_forecast.add_trace(
            go.Scatter(
                x=[min_price, max_price],
                y=[min_price, max_price],
                mode='lines',
                name='Perfect Prediction',
                line=dict(dash='dash', color='gray')
            )
        )
        
        fig_forecast.show()
        
        # Model accuracy by market
        accuracy_by_market = (forecast_data
                             .groupby('market')
                             ['prediction_confidence']
                             .mean()
                             .sort_values(ascending=False))
        
        print("🎯 Model Accuracy by Market:")
        display(accuracy_by_market.to_frame())
    
    # Anomaly detection results
    anomaly_data = (spark.table("energy_market_intelligence.ml_anomaly_detection")
                   .filter(col("timestamp_utc") >= date_sub(current_timestamp(), 1))
                   .filter(col("is_anomaly") == 1)
                   .select("timestamp_utc", "market", "price_usd", "anomaly_score")
                   .toPandas())
    
    if len(anomaly_data) > 0:
        print(f"\n⚠️ Anomalies Detected (Last 24 Hours): {len(anomaly_data)}")
        display(anomaly_data.head(10))
        
        # Anomaly timeline
        fig_anomaly = px.timeline(
            anomaly_data,
            x_start='timestamp_utc',
            x_end='timestamp_utc',
            y='market',
            color='anomaly_score',
            title='Market Anomalies Timeline'
        )
        
        fig_anomaly.show()

create_ml_dashboard()

