def create_alert_system():
    """
    Create real-time alert system for critical market events
    """
    
    alerts = []
    
    # Price spike alerts
    try:
        price_spikes = (spark.table("energy_market_intelligence.silver_unified_markets")
                       .filter(col("timestamp_utc") >= date_sub(current_timestamp(), 0.25))  # Last 6 hours
                       .filter(col("price_change_pct") > 10)  # Price change > 10%
                       .select("market", "price_usd", "price_change_pct", "timestamp_utc")
                       .collect())
        
        for spike in price_spikes:
            alerts.append({
                "type": "PRICE_SPIKE",
                "severity": "HIGH",
                "message": f"Price spike detected in {spike['market']}: {spike['price_change_pct']:.1f}%",
                "timestamp": spike['timestamp_utc'],
                "value": spike['price_usd']
            })
    except:
        pass
    
    # High-value arbitrage alerts
    try:
        high_value_arb = (spark.table("energy_market_intelligence.silver_arbitrage_opportunities")
                         .filter(col("profit_potential") > 1000)
                         .filter(col("opportunity_score") > 0.8)
                         .filter(col("timestamp") >= date_sub(current_timestamp(), 0.25))
                         .collect())
        
        for arb in high_value_arb:
            alerts.append({
                "type": "ARBITRAGE_OPPORTUNITY",
                "severity": "HIGH",
                "message": f"High-value arbitrage: {arb['market_buy']} -> {arb['market_sell']} (${arb['profit_potential']:.0f})",
                "timestamp": arb['timestamp'],
                "value": arb['profit_potential']
            })
    except:
        pass
    
    # Anomaly alerts
    try:
        recent_anomalies = (spark.table("energy_market_intelligence.ml_anomaly_detection")
                           .filter(col("is_anomaly") == 1)
                           .filter(col("timestamp_utc") >= date_sub(current_timestamp(), 0.25))
                           .collect())
        
        for anomaly in recent_anomalies:
            alerts.append({
                "type": "MARKET_ANOMALY",
                "severity": "MEDIUM",
                "message": f"Market anomaly detected in {anomaly['market']} (score: {anomaly['anomaly_score']:.2f})",
                "timestamp": anomaly['timestamp_utc'],
                "value": anomaly['anomaly_score']
            })
    except:
        pass
    
    # Display alerts
    if alerts:
        print("🚨 ACTIVE ALERTS:")
        for alert in sorted(alerts, key=lambda x: x['timestamp'], reverse=True)[:10]:
            severity_emoji = "🔴" if alert['severity'] == "HIGH" else "🟡"
            print(f"  {severity_emoji} {alert['type']}: {alert['message']}")
    else:
        print("✅ No active alerts - All systems normal")
    
    return alerts

alerts = create_alert_system()

