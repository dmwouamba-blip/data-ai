def create_hub_intelligence_dashboard():
    """
    Create dashboard showing activity and performance across trading hubs
    """
    
    # Get hub performance data
    hub_data = (spark.table("energy_market_intelligence.gold_trading_hub_performance")
               .filter(col("trading_date") >= date_sub(current_date(), 7))
               .toPandas())
    
