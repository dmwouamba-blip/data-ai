        )
        
        fig_sentiment.show()
        
        # Intelligence score over time
        comm_data['timestamp'] = pd.to_datetime(comm_data['timestamp'])
        hourly_intel = (comm_data
                       .set_index('timestamp')
                       .resample('H')
                       ['intelligence_score']
                       .mean()
                       .fillna(0))
        
        fig_intel = px.line(
            x=hourly_intel.index,
            y=hourly_intel.values,
            title='Market Intelligence Score Trend',
            labels={'x': 'Time', 'y': 'Average Intelligence Score'}
