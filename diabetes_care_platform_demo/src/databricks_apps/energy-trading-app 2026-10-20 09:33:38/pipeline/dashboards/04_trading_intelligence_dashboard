def create_global_market_overview():
    """
    Create real-time overview of all global energy markets
    """
    
    # Get latest market data
    market_data = (spark.table("energy_market_intelligence.silver_unified_markets")
                  .filter(col("timestamp_utc") >= date_sub(current_timestamp(), 1))
                  .groupBy("market")
                  .agg(
                      last("price_usd").alias("current_price"),
                      avg("price_usd").alias("avg_price_24h"),
                      min("price_usd").alias("min_price_24h"),
                      max("price_usd").alias("max_price_24h"),
                      sum("volume").alias("total_volume_24h"),
                      last("timestamp_utc").alias("last_update")
                  )
                  .toPandas())
    
    # Calculate price changes
    market_data['price_change'] = market_data['current_price'] - market_data['avg_price_24h']
    market_data['price_change_pct'] = (market_data['price_change'] / market_data['avg_price_24h']) * 100
    
    # Create market overview cards
    fig = make_subplots(
        rows=2, cols=3,
        subplot_titles=[f"{market.upper().replace('_', ' ')}" for market in market_data['market']],
        specs=[[{"type": "indicator"}] * 3] * 2
    )
    
    for i, row in market_data.iterrows():
        row_idx = (i // 3) + 1
        col_idx = (i % 3) + 1
        
        color = "green" if row['price_change'] >= 0 else "red"
        
        fig.add_trace(
            go.Indicator(
                mode="number+delta",
                value=row['current_price'],
                delta={
                    "reference": row['avg_price_24h'],
                    "valueformat": ".2f",
                    "relative": True
                },
                title={"text": f"${row['current_price']:.2f}/MWh"},
                number={"prefix": "$", "font": {"size": 24}},
                domain={'row': row_idx-1, 'column': col_idx-1}
            ),
            row=row_idx, col=col_idx
        )
    
    fig.update_layout(
        title="Global Energy Market Overview - Real-Time Prices",
        height=500,
        showlegend=False
    )
    
    fig.show()
    
    # Market summary table
    display(market_data[['market', 'current_price', 'price_change_pct', 'total_volume_24h']])

create_global_market_overview()

