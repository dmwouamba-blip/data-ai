def create_communication_dashboard():
    """
    Create dashboard for communication intelligence and sentiment analysis
    """
    
    # Recent communications
    comm_data = (spark.table("energy_market_intelligence.silver_communications")
                .filter(col("timestamp") >= date_sub(current_timestamp(), 1))
                .orderBy(desc("intelligence_score"))
                .toPandas())
    
