def create_price_trend_dashboard():
    """
    Create interactive price trend analysis across all markets
    """
    
    # Get recent price data
    price_data = (spark.table("energy_market_intelligence.silver_unified_markets")
                 .filter(col("timestamp_utc") >= date_sub(current_timestamp(), 7))
                 .select("timestamp_utc", "market", "price_usd", "volume")
                 .toPandas())
    
    # Convert timestamp to datetime
    price_data['timestamp_utc'] = pd.to_datetime(price_data['timestamp_utc'])
    
    # Create price trend chart
    fig = px.line(
        price_data, 
        x='timestamp_utc', 
        y='price_usd',
        color='market',
        title='7-Day Price Trends Across Global Markets',
        labels={'price_usd': 'Price (USD/MWh)', 'timestamp_utc': 'Time (UTC)'}
    )
    
    fig.update_layout(
        height=600,
        xaxis_title="Time (UTC)",
        yaxis_title="Price (USD/MWh)",
        legend_title="Market"
    )
    
    fig.show()
    
    # Volatility heatmap
    hourly_data = (price_data
                  .set_index('timestamp_utc')
                  .groupby(['market', pd.Grouper(freq='H')])
                  ['price_usd'].agg(['mean', 'std'])
                  .reset_index())
    
    volatility_matrix = hourly_data.pivot(index='timestamp_utc', columns='market', values='std')
    
    fig_heatmap = px.imshow(
        volatility_matrix.T,
        title="Price Volatility Heatmap (Last 7 Days)",
        labels={'x': 'Time', 'y': 'Market', 'color': 'Volatility (USD)'},
        aspect="auto"
    )
    
    fig_heatmap.show()

create_price_trend_dashboard()

