def create_arbitrage_dashboard():
    """
    Create real-time arbitrage opportunities dashboard
    """
    
    # Get enhanced arbitrage data
    arbitrage_data = (spark.table("energy_market_intelligence.silver_arbitrage_opportunities")
                     .filter(col("timestamp") >= date_sub(current_timestamp(), 1))
                     .filter(col("opportunity_score") > 0.5)
                     .orderBy(desc("opportunity_score"))
                     .toPandas())
    
    if len(arbitrage_data) > 0:
        # Create arbitrage opportunities scatter plot
        fig = px.scatter(
            arbitrage_data,
            x='spread',
            y='profit_potential',
            color='opportunity_score',
            size='volume_potential',
            hover_data=['market_buy', 'market_sell', 'confidence_score'],
            title='Real-Time Arbitrage Opportunities',
            labels={
                'spread': 'Price Spread (USD/MWh)',
                'profit_potential': 'Profit Potential (USD)',
                'opportunity_score': 'Opportunity Score'
            }
        )
        
        fig.update_layout(height=500)
        fig.show()
        
        # Top arbitrage opportunities table
        print("🚀 Top Arbitrage Opportunities:")
        top_opportunities = arbitrage_data.head(10)[
            ['market_buy', 'market_sell', 'spread', 'profit_potential', 'opportunity_score', 'execution_priority']
        ]
        display(top_opportunities)
        
        # Market pair analysis
        pair_analysis = (arbitrage_data
                        .groupby(['market_buy', 'market_sell'])
                        .agg({
                            'spread': 'mean',
                            'profit_potential': 'sum',
                            'opportunity_score': 'mean'
                        })
                        .round(2)
                        .sort_values('profit_potential', ascending=False))
        
        print("\n📊 Market Pair Performance:")
        display(pair_analysis)
    else:
        print("No active arbitrage opportunities meeting criteria")

create_arbitrage_dashboard()

