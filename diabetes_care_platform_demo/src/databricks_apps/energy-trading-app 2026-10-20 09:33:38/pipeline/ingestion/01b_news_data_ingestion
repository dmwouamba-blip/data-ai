def ingest_real_time_news(hours_back: int = 6) -> pd.DataFrame:
    """Ingest real-time news from all configured sources with intelligent fallback"""
    
    print(f"🔄 Starting news ingestion for last {hours_back} hours...")
    print(f"📊 Mode: {DATA_SOURCE_MODE}")
    
    # Determine data source strategy
    if DATA_SOURCE_MODE == "synthetic":
        print("🎭 Using synthetic data generation only")
        return generate_synthetic_news_data(hours_back)
    
    elif DATA_SOURCE_MODE == "real_apis" and CAN_USE_REAL_APIS:
        print("🌐 Using real APIs only")
        return fetch_from_real_apis(hours_back)
    
    elif DATA_SOURCE_MODE == "mixed":
        print("🔄 Using mixed approach: APIs + synthetic fallback")
        
        # Try real APIs first
        if CAN_USE_REAL_APIS:
            print("   🌐 Attempting real API integration...")
            api_data = fetch_from_real_apis(hours_back)
            
            if not api_data.empty:
                print(f"   ✅ Retrieved {len(api_data)} articles from APIs")
                
                # Supplement with synthetic data if needed
                if len(api_data) < 10:  # If we got very few articles
                    print("   📈 Supplementing with synthetic data...")
                    synthetic_data = generate_synthetic_news_data(hours_back // 2)
                    if not synthetic_data.empty:
                        combined_data = pd.concat([api_data, synthetic_data], ignore_index=True)
                        print(f"   ✅ Combined: {len(api_data)} real + {len(synthetic_data)} synthetic articles")
                        return combined_data
                
                return api_data
        
        # Fall back to synthetic data
        print("   🎭 Falling back to synthetic data generation...")
        return generate_synthetic_news_data(hours_back)
    
    else:
        print("⚠️  Invalid configuration, using synthetic data")
        return generate_synthetic_news_data(hours_back)

def fetch_from_real_apis(hours_back: int = 6) -> pd.DataFrame:
    """Fetch news from real APIs with enhanced error handling"""
    
    all_articles = []
    
    try:
        # Try to use external API integration module
        if API_MODULES_AVAILABLE and 'EnergyNewsIntegrator' in globals():
            integrator = EnergyNewsIntegrator()
            api_df = integrator.fetch_all_news(hours_back=hours_back)
            
            if not api_df.empty:
                print(f"✅ External API module: {len(api_df)} articles")
                return api_df
    
    except Exception as e:
        print(f"⚠️  External API module error: {e}")
    
    # Built-in API integrations
    print("🔧 Using built-in API integrations...")
    
    # NewsAPI integration
    if api_configs['newsapi_key']:
        try:
            newsapi_articles = fetch_from_newsapi(hours_back)
            all_articles.extend(newsapi_articles)
            print(f"   📰 NewsAPI: {len(newsapi_articles)} articles")
        except Exception as e:
            print(f"   ❌ NewsAPI error: {e}")
    
    # Alpha Vantage News integration
    if api_configs['alpha_vantage_key']:
        try:
            av_articles = fetch_from_alpha_vantage(hours_back)
            all_articles.extend(av_articles)
            print(f"   📈 Alpha Vantage: {len(av_articles)} articles")
        except Exception as e:
            print(f"   ❌ Alpha Vantage error: {e}")
    
    # Finnhub News integration
    if api_configs['finnhub_key']:
        try:
            finnhub_articles = fetch_from_finnhub(hours_back)
            all_articles.extend(finnhub_articles)
            print(f"   🏦 Finnhub: {len(finnhub_articles)} articles")
        except Exception as e:
            print(f"   ❌ Finnhub error: {e}")
    
    if all_articles:
        return pd.DataFrame(all_articles)
    else:
        print("⚠️  No articles retrieved from any API")
        return pd.DataFrame()

def fetch_from_newsapi(hours_back: int) -> list:
    """Fetch energy news from NewsAPI"""
    
    if not api_configs['newsapi_key']:
        return []
    
    try:
        from_date = (datetime.now() - timedelta(hours=hours_back)).isoformat()
        
        # Energy-related queries
        queries = ['energy OR oil OR gas OR electricity OR renewables OR coal OR nuclear']
        articles = []
        
        for query in queries:
            url = f"https://newsapi.org/v2/everything"
            params = {
                'q': query,
                'from': from_date,
                'sortBy': 'publishedAt',
                'pageSize': 20,
                'language': 'en',
                'apiKey': api_configs['newsapi_key']
            }
            
            response = requests.get(url, params=params, timeout=30)
            if response.status_code == 200:
                data = response.json()
                for article in data.get('articles', []):
                    articles.append({
                        'title': article.get('title', ''),
                        'content': article.get('content', article.get('description', '')),
                        'source': article.get('source', {}).get('name', 'NewsAPI'),
                        'author': article.get('author', 'Unknown'),
                        'published_date': pd.to_datetime(article.get('publishedAt')),
                        'url': article.get('url', ''),
                        'sentiment_score': np.random.uniform(-0.5, 0.5),  # Placeholder
                        'relevance_score': np.random.uniform(0.5, 1.0),
                        'geographic_region': 'global',
                        'market_mentioned': np.random.choice(['oil', 'gas', 'electricity', 'renewables']),
                        'breaking_news': False,
                        'ingestion_timestamp': datetime.now()
                    })
        
        return articles[:50]  # Limit to 50 articles
        
    except Exception as e:
        print(f"NewsAPI error: {e}")
        return []

def fetch_from_alpha_vantage(hours_back: int) -> list:
    """Fetch news from Alpha Vantage"""
    
    if not api_configs['alpha_vantage_key']:
        return []
    
    try:
        url = "https://www.alphavantage.co/query"
        params = {
            'function': 'NEWS_SENTIMENT',
            'topics': 'energy',
            'time_from': (datetime.now() - timedelta(hours=hours_back)).strftime('%Y%m%dT%H%M'),
            'limit': 50,
            'apikey': api_configs['alpha_vantage_key']
        }
        
        response = requests.get(url, params=params, timeout=30)
        if response.status_code == 200:
            data = response.json()
            articles = []
            
            for item in data.get('feed', []):
                articles.append({
                    'title': item.get('title', ''),
                    'content': item.get('summary', ''),
                    'source': item.get('source', 'Alpha Vantage'),
                    'author': item.get('authors', ['Unknown'])[0] if item.get('authors') else 'Unknown',
                    'published_date': pd.to_datetime(item.get('time_published'), format='%Y%m%dT%H%M%S'),
                    'url': item.get('url', ''),
                    'sentiment_score': float(item.get('overall_sentiment_score', 0)),
                    'relevance_score': float(item.get('relevance_score', 0.5)),
                    'geographic_region': 'global',
                    'market_mentioned': 'energy',
                    'breaking_news': False,
                    'ingestion_timestamp': datetime.now()
                })
                
            return articles
            
    except Exception as e:
        print(f"Alpha Vantage error: {e}")
        return []

