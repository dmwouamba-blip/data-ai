def generate_realistic_content(topic: str, keywords: list) -> str:
    """Generate realistic article content"""
    
    base_content = f"Energy markets showed significant movement today as {topic.lower()} continues to impact global trading. "
    
    # Add topic-specific content
    if 'oil' in keywords:
        base_content += f"Crude oil benchmarks responded to supply chain developments, with traders monitoring production levels and inventory data. "
    elif 'gas' in keywords:
        base_content += f"Natural gas markets experienced volatility driven by storage reports and demand forecasts from key consuming regions. "
    elif 'power' in keywords or 'electricity' in keywords:
        base_content += f"Electricity markets faced challenges from grid balancing requirements and renewable energy integration efforts. "
    elif any(k in keywords for k in ['solar', 'wind', 'renewable']):
        base_content += f"Renewable energy sector developments influenced market sentiment and investment flows across the energy complex. "
    
    # Add market analysis
    base_content += f"Market participants are closely watching upcoming economic indicators and regulatory announcements that could impact energy prices. "
    base_content += f"Trading activity remained elevated as institutional investors adjusted their positions based on evolving market conditions."
    
    return base_content

def generate_contextual_sentiment(content: str, keywords: list) -> float:
    """Generate realistic sentiment scores based on content"""
    
    positive_terms = ['rise', 'surge', 'increase', 'growth', 'strong', 'robust', 'positive', 'gains']
    negative_terms = ['fall', 'drop', 'decline', 'concerns', 'volatility', 'disruption', 'weak', 'losses']
    
    content_lower = content.lower()
    positive_count = sum(1 for term in positive_terms if term in content_lower)
    negative_count = sum(1 for term in negative_terms if term in content_lower)
    
    if positive_count > negative_count:
        return np.random.uniform(0.1, 0.8)
    elif negative_count > positive_count:
        return np.random.uniform(-0.8, -0.1)
    else:
        return np.random.uniform(-0.3, 0.3)

