def enrich_news_data(df: pd.DataFrame) -> pd.DataFrame:
    """Apply data quality checks and enrichment"""
    
    if df.empty:
        return df
    
    # Ensure we're working with a pandas DataFrame
    if not isinstance(df, pd.DataFrame):
        print("⚠️  Converting to pandas DataFrame...")
        if hasattr(df, 'toPandas'):
            df = df.toPandas()
        else:
            raise TypeError(f"Expected pandas DataFrame, got {type(df)}")
    
    print(f"🧹 Starting data quality and enrichment process...")
    original_count = len(df)
    
    # 1. Remove duplicates based on title similarity
    print("   🔍 Removing duplicates...")
    df['title_normalized'] = df['title'].str.lower().str.strip()
    df = df.drop_duplicates(subset=['title_normalized'], keep='first')
    df = df.drop('title_normalized', axis=1)
    print(f"   📉 Removed {original_count - len(df)} duplicates")
    
    # 2. Validate required fields
    print("   ✅ Validating required fields...")
    required_fields = ['title', 'content', 'source', 'published_date']
    for field in required_fields:
        before_count = len(df)
        df = df.dropna(subset=[field])
        if len(df) < before_count:
            print(f"   📉 Removed {before_count - len(df)} rows with missing {field}")
    
    # 3. Enhance sentiment analysis
    print("   🎭 Enhancing sentiment analysis...")
    df = enhance_sentiment_analysis(df)
    
    # 4. Improve relevance scoring
    print("   🎯 Improving relevance scoring...")
    df = enhance_relevance_scoring(df)
    
    # 5. Add market timing analysis
    print("   ⏰ Adding market timing analysis...")
    df = add_market_timing_features(df)
    
    # 6. Generate article IDs if missing
    if 'article_id' not in df.columns or df['article_id'].isna().any():
        df['article_id'] = [f"news_{datetime.now().strftime('%Y%m%d')}_{i:04d}" for i in range(len(df))]
    
    print(f"✅ Data enrichment completed: {len(df)} articles ready")
    return df

def enhance_sentiment_analysis(df: pd.DataFrame) -> pd.DataFrame:
    """Enhanced sentiment analysis with energy-specific terms"""
    
    # Energy-specific sentiment lexicon
    positive_energy_terms = [
        'breakthrough', 'efficiency', 'growth', 'profit', 'gain', 'rise', 'increase',
        'abundant', 'discovery', 'innovation', 'renewable', 'clean', 'sustainable',
        'record high', 'surge', 'boost', 'expansion', 'investment', 'deal', 'agreement'
    ]
    
    negative_energy_terms = [
        'shortage', 'crisis', 'outage', 'disruption', 'decline', 'fall', 'drop',
        'pollution', 'spill', 'accident', 'shutdown', 'closure', 'embargo', 'sanctions',
        'volatility', 'uncertainty', 'loss', 'deficit', 'risk', 'threat', 'conflict'
    ]
    
    def calculate_enhanced_sentiment(text):
        if pd.isna(text):
            return 0.0
        
        text_lower = str(text).lower()
        positive_count = sum(1 for term in positive_energy_terms if term in text_lower)
        negative_count = sum(1 for term in negative_energy_terms if term in text_lower)
        
        total_terms = positive_count + negative_count
        if total_terms == 0:
            return 0.0
        
        sentiment = (positive_count - negative_count) / total_terms
        return max(-1.0, min(1.0, sentiment))  # Clamp between -1 and 1
    
    # Calculate enhanced sentiment
    df['enhanced_sentiment'] = df.apply(
        lambda row: calculate_enhanced_sentiment(f"{row['title']} {row['content']}"),
        axis=1
    )
    
    # Blend with existing sentiment if available
    if 'sentiment_score' in df.columns:
        df['sentiment_score'] = (df['sentiment_score'].fillna(0) + df['enhanced_sentiment']) / 2
    else:
        df['sentiment_score'] = df['enhanced_sentiment']
    
    df = df.drop('enhanced_sentiment', axis=1)
    return df

def enhance_relevance_scoring(df: pd.DataFrame) -> pd.DataFrame:
    """Enhanced relevance scoring for energy market intelligence"""
    
    # Energy market relevance keywords with weights
    relevance_keywords = {
        # Core energy terms (high weight)
        'oil': 3, 'gas': 3, 'electricity': 3, 'power': 3, 'energy': 3,
        'coal': 2, 'nuclear': 2, 'renewable': 2, 'solar': 2, 'wind': 2,
        
        # Trading terms (high weight)
        'trading': 3, 'arbitrage': 3, 'futures': 2, 'commodity': 2, 'price': 2,
        
        # Market names (very high weight)
        'epex': 4, 'nordpool': 4, 'pjm': 4, 'ice endex': 4, 'eex': 4,
        
        # Company specific (high weight)
        'totalenergies': 4, 'total energies': 4,
        
        # Geographic relevance (medium weight)
        'europe': 1, 'north america': 1, 'asia': 1, 'middle east': 1,
        
        # Infrastructure (medium weight)
        'pipeline': 2, 'refinery': 2, 'grid': 2, 'lng': 2, 'storage': 1
    }
    
    def calculate_enhanced_relevance(text):
        if pd.isna(text):
            return 0.0
        
        text_lower = str(text).lower()
        total_score = 0
        max_possible = sum(relevance_keywords.values())
        
        for keyword, weight in relevance_keywords.items():
            if keyword in text_lower:
                total_score += weight
        
        return min(1.0, total_score / max_possible)  # Normalize to 0-1
    
    # Calculate enhanced relevance
    df['enhanced_relevance'] = df.apply(
        lambda row: calculate_enhanced_relevance(f"{row['title']} {row['content']}"),
        axis=1
    )
    
    # Blend with existing relevance if available
    if 'relevance_score' in df.columns:
        df['relevance_score'] = (df['relevance_score'].fillna(0) + df['enhanced_relevance']) / 2
    else:
        df['relevance_score'] = df['enhanced_relevance']
    
    df = df.drop('enhanced_relevance', axis=1)
    return df

def add_market_timing_features(df: pd.DataFrame) -> pd.DataFrame:
    """Add market timing and session analysis"""
    
    # Trading sessions mapping
    trading_sessions = {
        'asia_pacific': {'start': 0, 'end': 8},    # 12 AM - 8 AM UTC
        'europe': {'start': 7, 'end': 17},         # 7 AM - 5 PM UTC  
        'north_america': {'start': 13, 'end': 22}  # 1 PM - 10 PM UTC
    }
    
    def determine_trading_session(timestamp):
        if pd.isna(timestamp):
            return 'unknown'
        
        hour_utc = timestamp.hour
        sessions = []
        
        for session, times in trading_sessions.items():
            if times['start'] <= hour_utc <= times['end']:
                sessions.append(session)
        
        return ','.join(sessions) if sessions else 'off_hours'
    
    def is_market_hours(timestamp, region):
        if pd.isna(timestamp):
            return False
        
        hour_utc = timestamp.hour
        weekday = timestamp.weekday()  # 0=Monday, 6=Sunday
        
        # Weekend check
        if weekday >= 5:  # Saturday or Sunday
            return False
        
        # Region-specific market hours (approximate)
        market_hours = {
            'Europe': (7, 17),
            'North America': (13, 22),
            'Asia Pacific': (0, 8),
            'Global': (0, 24)
        }
        
        start_hour, end_hour = market_hours.get(region, (0, 24))
        return start_hour <= hour_utc <= end_hour
    
    # Add timing features
    df['trading_session'] = df['published_date'].apply(determine_trading_session)
    df['is_market_hours'] = df.apply(
        lambda row: is_market_hours(row['published_date'], row.get('geographic_region', 'Global')),
        axis=1
    )
    
    # Add time-based urgency score
    def calculate_urgency_score(timestamp, breaking_news):
        if pd.isna(timestamp):
            return 0.0
        
        hours_old = (datetime.now() - timestamp).total_seconds() / 3600
        
        # Base urgency decreases with age
        urgency = max(0.0, 1.0 - (hours_old / 24))  # Linear decay over 24 hours
        
        # Breaking news gets urgency boost
        if breaking_news:
            urgency = min(1.0, urgency + 0.3)
        
        return urgency
    
    df['urgency_score'] = df.apply(
        lambda row: calculate_urgency_score(
            row['published_date'], 
            row.get('breaking_news', False)
        ),
        axis=1
    )
    
    return df

