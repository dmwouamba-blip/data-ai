    # Check if we can load from existing Delta table
    if USE_DELTA_TABLES:
        try:
            # Try to load from the Delta table created by orchestration notebook
            delta_path = f"/Volumes/{CATALOG_NAME}/{SCHEMA_NAME}/demo_data/news_articles"
            
            # Read as Spark DataFrame first
            spark_df = spark.read.format("delta").load(delta_path)
            news_df = spark_df.toPandas()
            
            # Filter to recent articles
            cutoff_time = datetime.now() - timedelta(hours=hours_back)
            recent_news = news_df[pd.to_datetime(news_df['published_date']) >= cutoff_time].copy()
            
            if not recent_news.empty:
                # Update ingestion timestamp
                recent_news['ingestion_timestamp'] = datetime.now()
                print(f"📰 Loaded {len(recent_news)} articles from Delta table")
                return recent_news
            else:
                print("⚠️  No recent articles in Delta table, generating fresh synthetic data...")
                
        except Exception as e:
            print(f"⚠️  Could not load from Delta table: {e}")
            print("📁 Generating fresh synthetic data...")
    
    # Generate fresh synthetic data
    return create_synthetic_news_articles(hours_back)

