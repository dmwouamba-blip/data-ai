def generate_news_alerts(df):
    """Generate trading alerts based on news analysis"""
    
    if df.empty:
        print("❌ No data available for alert generation")
        return []
    
    alerts = []
    
    # 1. High-impact negative news alert
    high_negative_news = df[
        (df.get('sentiment_score', 0) < -0.5) & 
        (df.get('market_impact', '') == 'high') &
        (df.get('relevance_score', 0) > 0.7)
    ]
    
    if not high_negative_news.empty:
        alerts.append({
            'type': 'MARKET_RISK',
            'severity': 'HIGH',
            'title': f'High-Impact Negative News Detected',
            'description': f'{len(high_negative_news)} high-impact negative articles may affect market sentiment',
            'recommendation': 'Consider reducing exposure and monitoring for price volatility',
            'articles': len(high_negative_news)
        })
    
    # 2. Breaking news alert
    breaking_news = df[df.get('breaking_news', False) == True]
    
    if not breaking_news.empty:
        alerts.append({
            'type': 'BREAKING_NEWS',
            'severity': 'MEDIUM',
            'title': f'Breaking Energy News',
            'description': f'{len(breaking_news)} breaking news articles require attention',
            'recommendation': 'Review breaking news for immediate trading implications',
            'articles': len(breaking_news)
        })
    
    # 3. Unusual sentiment shift alert
    if len(df) > 10:
        recent_sentiment = df.nlargest(10, 'published_date')['sentiment_score'].mean()
        overall_sentiment = df['sentiment_score'].mean()
        sentiment_shift = abs(recent_sentiment - overall_sentiment)
        
        if sentiment_shift > 0.3:
            alerts.append({
                'type': 'SENTIMENT_SHIFT',
                'severity': 'MEDIUM',
                'title': f'Unusual Sentiment Shift Detected',
                'description': f'Recent articles show {sentiment_shift:.3f} sentiment deviation from baseline',
                'recommendation': 'Monitor for potential market trend changes',
                'articles': 10
            })
    
    # 4. High-relevance opportunity alert
    high_relevance = df[
        (df.get('relevance_score', 0) > 0.8) & 
        (df.get('sentiment_score', 0) > 0.3) &
        (df.get('market_impact', '') != 'low')
    ]
    
    if not high_relevance.empty:
        alerts.append({
            'type': 'OPPORTUNITY',
            'severity': 'LOW',
            'title': f'Positive Market Signals',
            'description': f'{len(high_relevance)} articles suggest positive market developments',
            'recommendation': 'Evaluate potential opportunities in mentioned markets/sectors',
            'articles': len(high_relevance)
        })
    
    return alerts

def display_alerts(alerts):
    """Display generated alerts in a formatted way"""
    
    if not alerts:
        print("✅ No significant alerts generated")
        return
    
    print("🚨 News-Based Trading Alerts:")
    print("=" * 50)
    
    severity_icons = {'HIGH': '🔴', 'MEDIUM': '🟡', 'LOW': '🟢'}
    
    for i, alert in enumerate(alerts, 1):
        icon = severity_icons.get(alert['severity'], '⚪')
        print(f"{icon} Alert {i}: {alert['title']}")
        print(f"   Type: {alert['type']}")
        print(f"   Severity: {alert['severity']}")
        print(f"   Description: {alert['description']}")
        print(f"   Recommendation: {alert['recommendation']}")
        print(f"   Related Articles: {alert['articles']}")
        print()

