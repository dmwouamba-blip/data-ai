import random
import json
import pytz
from datetime import datetime, timedelta, timezone
from typing import Dict, List

class EnergyMarketDataGenerator:
    """Generates comprehensive synthetic energy market data for demo purposes"""
    
    def __init__(self):
        self.start_date = datetime.now(timezone.utc) - timedelta(days=30)
        self.end_date = datetime.now(timezone.utc)
        
        # Market parameters (from original version)
        self.markets = {
            'epex_spot': {'base_price': 45.0, 'volatility': 0.15, 'timezone': 'Europe/Berlin'},
            'ice_endex': {'base_price': 48.5, 'volatility': 0.12, 'timezone': 'Europe/London'},
            'nord_pool': {'base_price': 42.0, 'volatility': 0.18, 'timezone': 'Europe/Oslo'},
            'pjm': {'base_price': 35.0, 'volatility': 0.20, 'timezone': 'America/New_York'},
            'eex': {'base_price': 46.8, 'volatility': 0.14, 'timezone': 'Europe/Berlin'}
        }
        
        self.traders = {
            'geneva': ['Marie Dubois', 'Hans Mueller', 'Anna Kowalski', 'Luca Rossi'],
            'houston': ['John Smith', 'Maria Garcia', 'David Johnson', 'Lisa Wong'],
            'singapore': ['Li Wei', 'Raj Patel', 'Sarah Kim', 'Ahmed Hassan'],
            'dubai': ['Omar Al-Rashid', 'Fatima Al-Zahra', 'Khalil Mansour', 'Leila Nazari']
        }

    def generate_market_prices(self, market: str, days: int = 30) -> pd.DataFrame:
        """Generate synthetic market price data"""
        market_config = self.markets[market]
        tz = pytz.timezone(market_config['timezone'])
        
        timestamps = []
        current = self.start_date.astimezone(tz)
        
        while current <= self.end_date.astimezone(tz):
            if 6 <= current.hour <= 22:  # Trading hours
                timestamps.append(current)
            current += timedelta(minutes=15)
        
        base_price = market_config['base_price']
        volatility = market_config['volatility']
        
        prices, volumes = [], []
        for i, ts in enumerate(timestamps):
            hour_factor = 1 + 0.3 * np.sin(2 * np.pi * ts.hour / 24)
            day_factor = 1 + 0.1 * np.sin(2 * np.pi * ts.weekday() / 7)
            
            if i == 0:
                price = base_price * hour_factor * day_factor
            else:
                price_change = np.random.normal(0, volatility * base_price / 100)
                price = python_max(0, prices[-1] + price_change)
            
            base_volume = random.uniform(800, 1200)
            volume_factor = 1.5 if i > 0 and python_abs(price - prices[-1]) > prices[-1] * 0.05 else 1
            
            prices.append(price)
            volumes.append(base_volume * volume_factor * hour_factor)
        
        return pd.DataFrame({
            'timestamp': timestamps,
            'market': market,
            'price': prices,
            'volume': volumes,
            'currency': 'EUR' if market in ['epex_spot', 'eex'] else 'USD',
            'product': 'Power' if market in ['epex_spot', 'nord_pool', 'pjm'] else 'Gas',
            'delivery_start': timestamps,
            'delivery_end': [ts + timedelta(hours=1) for ts in timestamps],
            'bid_price': [p * 0.995 for p in prices],
            'ask_price': [p * 1.005 for p in prices],
            'last_trade_price': prices,
            'source_system': f'{market}_api'
        })

