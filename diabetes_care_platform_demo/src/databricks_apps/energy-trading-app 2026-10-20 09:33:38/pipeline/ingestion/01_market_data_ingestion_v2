def create_streaming_ingestion(source_path, schema, table_name, checkpoint_path):
    """
    Create a structured streaming DataFrame for data ingestion with backend-aligned schema
    """
    
    # Read from source (could be Kafka, Event Hub, or file-based for demo)
    raw_stream = (spark
        .readStream
        .format("cloudFiles")
        .option("cloudFiles.format", "json")  # Changed to JSON for better schema alignment
        .option("cloudFiles.schemaLocation", f"{checkpoint_path}/schema")
        .option("cloudFiles.inferColumnTypes", "false")
        .schema(schema)
        .load(source_path)
    )
    
    # Add metadata and enrichment
    enriched_stream = (raw_stream
        .withColumn("ingestion_timestamp", current_timestamp())
        .withColumn("data_source", lit("streaming_ingestion"))
        .withColumn("year", year(
            when(col("timestamp").isNotNull(), to_timestamp(col("timestamp")))
            .when(col("date").isNotNull(), to_date(col("date")))
            .otherwise(current_timestamp())
        ))
        .withColumn("month", month(
            when(col("timestamp").isNotNull(), to_timestamp(col("timestamp")))
            .when(col("date").isNotNull(), to_date(col("date")))
            .otherwise(current_timestamp())
        ))
        .withColumn("day", dayofmonth(
            when(col("timestamp").isNotNull(), to_timestamp(col("timestamp")))
            .when(col("date").isNotNull(), to_date(col("date")))
            .otherwise(current_timestamp())
        ))
    )
    
    return enriched_stream

def write_to_delta_table(stream_df, table_name, checkpoint_path, partition_cols=["year", "month", "day"]):
    """
    Write streaming data to Delta Lake table with backend-aligned partitioning
    """
    
    query = (stream_df
        .writeStream
        .format("delta")
        .outputMode("append")
        .option("checkpointLocation", checkpoint_path)
        .option("mergeSchema", "true")
        .partitionBy(*partition_cols)
        .table(f"{catalog_name}.{schema_name}.{table_name}")
        .trigger(processingTime="30 seconds")  # Process every 30 seconds
    )
    
    return query

print("Streaming ingestion functions defined")

