            elif col_name == "data_quality_score":
                spark_df = spark_df.withColumn(col_name, lit(0.95))
            else:
                # Add other missing columns with null values
                field_type = next(field.dataType for field in expected_schema.fields if field.name == col_name)
                if str(field_type) == "StringType":
                    spark_df = spark_df.withColumn(col_name, lit(None).cast("string"))
                elif str(field_type) == "TimestampType":
                    spark_df = spark_df.withColumn(col_name, lit(None).cast("timestamp"))
                elif str(field_type) == "DoubleType":
                    spark_df = spark_df.withColumn(col_name, lit(None).cast("double"))
                elif str(field_type) == "IntegerType":
                    spark_df = spark_df.withColumn(col_name, lit(None).cast("int"))
                elif str(field_type) == "LongType":
                    spark_df = spark_df.withColumn(col_name, lit(None).cast("long"))
                else:
                    spark_df = spark_df.withColumn(col_name, lit(None))
        
        # Now reorder columns to match schema
        schema_column_order = [field.name for field in expected_schema.fields]
