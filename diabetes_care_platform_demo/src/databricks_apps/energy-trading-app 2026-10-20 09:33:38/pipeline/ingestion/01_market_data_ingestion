# Create bronze layer tables for each market
markets = ["epex_spot", "ice_endex", "nord_pool", "pjm", "eex"]

for market in markets:
    spark.sql(f"""
        CREATE TABLE IF NOT EXISTS {catalog_name}.{schema_name}.bronze_market_prices_{market} (
            timestamp TIMESTAMP,
            market STRING,
            price DOUBLE,
            volume DOUBLE,
            currency STRING,
            product STRING,
            delivery_start TIMESTAMP,
            delivery_end TIMESTAMP,
            bid_price DOUBLE,
            ask_price DOUBLE,
            last_trade_price DOUBLE,
            source_system STRING,
            ingestion_timestamp TIMESTAMP,
            source_market STRING,
            data_quality_score DOUBLE,
            year INT,
            month INT,
            day INT,
            hour INT
        )
        USING DELTA
        PARTITIONED BY (year, month, day)
        TBLPROPERTIES (
            'delta.autoOptimize.optimizeWrite' = 'true',
            'delta.autoOptimize.autoCompact' = 'true'
        )
    """)

