# Validate data quality across all tables
print("=== Data Quality Report ===")

# Market data validation
for market in markets:
    try:
        df = spark.table(f"{catalog_name}.{schema_name}.bronze_market_prices_{market}")
        total_records = df.count()
        quality_records = df.filter(col("data_quality_score") == 1.0).count()
        latest_timestamp = df.agg(max("timestamp")).collect()[0][0]
        
        print(f"\n{market.upper()}:")
        print(f"  Total records: {total_records:,}")
        print(f"  High quality records: {quality_records:,} ({quality_records/total_records*100:.1f}%)")
        print(f"  Latest timestamp: {latest_timestamp}")
        
    except Exception as e:
        print(f"  Error validating {market}: {str(e)}")

# Arbitrage opportunities validation
try:
    arb_df = spark.table(f"{catalog_name}.{schema_name}.bronze_arbitrage_opportunities")
    total_arb = arb_df.count()
    high_confidence = arb_df.filter(col("confidence_score") > 0.8).count()
    avg_profit = arb_df.agg(avg("profit_potential")).collect()[0][0]
    
    print(f"\nARBITRAGE OPPORTUNITIES:")
    print(f"  Total opportunities: {total_arb:,}")
    print(f"  High confidence (>80%): {high_confidence:,}")
    print(f"  Average profit potential: €{avg_profit:,.2f}")
    
except Exception as e:
    print(f"  Error validating arbitrage data: {str(e)}")

# Communications validation
try:
    comm_df = spark.table(f"{catalog_name}.{schema_name}.bronze_communications")
    total_comm = comm_df.count()
    high_priority = comm_df.filter(col("priority") == "high").count()
    channels = comm_df.select("channel").distinct().count()
    
    print(f"\nCOMMUNICATIONS:")
    print(f"  Total messages: {total_comm:,}")
    print(f"  High priority messages: {high_priority:,}")
    print(f"  Active channels: {channels}")
    
except Exception as e:
    print(f"  Error validating communications data: {str(e)}")

print("\nData quality validation completed!")

