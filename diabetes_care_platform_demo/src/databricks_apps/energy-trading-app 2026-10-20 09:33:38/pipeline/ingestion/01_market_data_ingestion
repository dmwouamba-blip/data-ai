def create_market_data_stream(market_name, source_path, checkpoint_path):
    """
    Create a structured streaming DataFrame for market data ingestion
    """
    
    # Read from source (could be Kafka, Event Hub, or file-based for demo)
    raw_stream = (spark
        .readStream
        .format("cloudFiles")
        .option("cloudFiles.format", "csv")
        .option("header", "true")
        .option("inferSchema", "false")
        .schema(market_price_schema)
        .load(source_path)
    )
    
    # Add metadata and enrichment
    enriched_stream = (raw_stream
        .withColumn("ingestion_timestamp", current_timestamp())
        .withColumn("source_market", lit(market_name))
        .withColumn("data_quality_score", 
                   when(col("price").isNotNull() & (col("price") > 0), 1.0)
                   .otherwise(0.5))
        .withColumn("year", year(col("timestamp")))
        .withColumn("month", month(col("timestamp")))
        .withColumn("day", dayofmonth(col("timestamp")))
        .withColumn("hour", hour(col("timestamp")))
    )
    
    return enriched_stream

def write_to_delta_bronze(stream_df, table_name, checkpoint_path):
    """
    Write streaming data to Delta Lake bronze layer
    """
    
    query = (stream_df
        .writeStream
        .format("delta")
        .outputMode("append")
        .option("checkpointLocation", checkpoint_path)
        .option("mergeSchema", "true")
        .partitionBy("year", "month", "day")
        .table(f"energy_market_intelligence.bronze_{table_name}")
    )
    
    return query

print("Streaming functions defined")

