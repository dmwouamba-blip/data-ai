def upload_demo_data_to_volume():
    """Upload demo data from DBFS to Unity Catalog Volume"""
    
    source_path = "/FileStore/shared_uploads/totalenergies/demo_data/"
    target_path = f"/Volumes/{catalog_name}/{schema_name}/demo_data/"
    
    try:
        # List files in source
        files = dbutils.fs.ls(source_path)
        
        for file_info in files:
            if file_info.name.endswith('.csv'):
                source_file = file_info.path
                target_file = f"{target_path}{file_info.name}"
                
                # Copy file
                dbutils.fs.cp(source_file, target_file)
                print(f"✅ Uploaded {file_info.name} to volume")
                
    except Exception as e:
        print(f"❌ Error uploading demo data: {e}")
        print("Please ensure demo data is available in DBFS first")

def create_sample_data_in_volume():
    """Create sample data directly in volume for testing"""
    
    import pandas as pd
    from datetime import datetime, timedelta
    
    # Create sample market data
    sample_data = {
        'timestamp': [datetime.now() - timedelta(hours=i) for i in range(24)],
        'market': ['epex_spot'] * 24,
        'price': [50 + i * 0.5 for i in range(24)],
        'volume': [1000 + i * 10 for i in range(24)],
        'currency': ['EUR'] * 24
    }
    
    df = spark.createDataFrame(pd.DataFrame(sample_data))
    
    # Write to volume
    sample_path = f"/Volumes/{catalog_name}/{schema_name}/demo_data/sample_market_data.parquet"
    
    try:
        df.write.mode("overwrite").parquet(sample_path)
        print(f"✅ Created sample data at {sample_path}")
    except Exception as e:
        print(f"❌ Error creating sample data: {e}")

