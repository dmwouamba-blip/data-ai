# MAGIC ## Create Directory Structure in Volumes

# COMMAND ----------

# Create directory structure in main volume
volume_base_path = f"/Volumes/{catalog_name}/{schema_name}/{volume_name}"

directories = [
    "raw/market_prices",
    "raw/arbitrage_opportunities", 
    "raw/communications",
    "raw/trading_positions",
    "processed/silver",
    "processed/gold",
    "checkpoints/streaming",
    "models/arbitrage_detection",
    "models/price_forecasting",
    "models/sentiment_analysis",
    "models/anomaly_detection"
