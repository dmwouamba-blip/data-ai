# MAGIC %md
# MAGIC ## Grant Permissions and Set Up Governance

# COMMAND ----------

# Grant permissions to users and groups
# Note: Adjust these based on your organization's user/group structure

permissions_config = [
    ("account users", "USE CATALOG", catalog_name),
    ("account users", "USE SCHEMA", f"{catalog_name}.{schema_name}"),
    ("account users", "READ VOLUME", f"{catalog_name}.{schema_name}.{volume_name}"),
    ("account users", "SELECT", f"{catalog_name}.{schema_name}.*")
]

print("Setting up permissions (may require admin privileges):")

for principal, privilege, object_name in permissions_config:
    try:
        spark.sql(f"""
            GRANT {privilege} ON {object_name} TO `{principal}`
        """)
        print(f"✅ Granted {privilege} on {object_name} to {principal}")
    except Exception as e:
        print(f"❌ Error granting {privilege} on {object_name} to {principal}: {e}")

