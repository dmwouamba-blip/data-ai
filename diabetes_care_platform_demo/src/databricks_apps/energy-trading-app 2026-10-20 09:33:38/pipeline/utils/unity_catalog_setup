def validate_unity_catalog_setup():
    """Validate the Unity Catalog setup"""
    
    print("=== Unity Catalog Setup Validation ===")
    
    # Check catalog
    try:
        catalogs = spark.sql("SHOW CATALOGS").collect()
        catalog_names = [row['catalog'] for row in catalogs]
        
        if catalog_name in catalog_names:
            print(f"✅ Catalog '{catalog_name}' exists")
        else:
            print(f"❌ Catalog '{catalog_name}' not found")
    except Exception as e:
        print(f"❌ Error checking catalog: {e}")
    
    # Check schema
    try:
        schemas = spark.sql(f"SHOW SCHEMAS IN {catalog_name}").collect()
        schema_names = [row['databaseName'] for row in schemas]
        
        if schema_name in schema_names:
            print(f"✅ Schema '{schema_name}' exists")
        else:
            print(f"❌ Schema '{schema_name}' not found")
    except Exception as e:
        print(f"❌ Error checking schema: {e}")
    
    # Check volumes
    try:
        volumes = spark.sql(f"SHOW VOLUMES IN {catalog_name}.{schema_name}").collect()
        volume_names = [row['volume_name'] for row in volumes]
        
        if volume_name in volume_names:
            print(f"✅ Volume '{volume_name}' exists")
        else:
            print(f"❌ Volume '{volume_name}' not found")
            
        print(f"📁 Available volumes: {', '.join(volume_names)}")
    except Exception as e:
        print(f"❌ Error checking volumes: {e}")
    
    # Check volume accessibility
    try:
        volume_path = f"/Volumes/{catalog_name}/{schema_name}/{volume_name}"
        contents = dbutils.fs.ls(volume_path)
        print(f"✅ Volume '{volume_name}' is accessible")
        print(f"📂 Volume contents: {len(contents)} items")
    except Exception as e:
        print(f"❌ Error accessing volume: {e}")

# Run validation
validate_unity_catalog_setup()

