# COMMAND ----------

# MAGIC %md
# MAGIC ## AWS S3 External Location Setup

# COMMAND ----------

# Note: This requires appropriate IAM roles and policies to be set up
# Create external location for S3 integration (if needed)

external_location_name = f"{catalog_name}_s3_location"
s3_path = f"s3://{s3_bucket}/"

try:
    spark.sql(f"""
        CREATE EXTERNAL LOCATION IF NOT EXISTS {external_location_name}
        URL '{s3_path}'
        WITH (CREDENTIAL `databricks-s3-credential`)
        COMMENT 'External location for TotalEnergies S3 bucket'
    """)
    print(f"✅ External location '{external_location_name}' created/verified")
except Exception as e:
    print(f"❌ Error creating external location (may require admin privileges): {e}")

