import os
from pyspark.sql import SparkSession
from pyspark.sql.functions import *

# Unity Catalog configuration
catalog_name = "totalenergies"
schema_name = "energy_market_intelligence"
volume_name = "market_data"

# AWS S3 configuration
s3_bucket = "totalenergies-energy-data"
aws_region = "us-east-1"

print(f"Unity Catalog Setup Configuration:")
print(f"  Catalog: {catalog_name}")
print(f"  Schema: {schema_name}")
print(f"  Volume: {volume_name}")
print(f"  S3 Bucket: {s3_bucket}")
print(f"  AWS Region: {aws_region}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## Create Unity Catalog Structure

# COMMAND ----------

# Create catalog
try:
    spark.sql(f"""
        CREATE CATALOG IF NOT EXISTS {catalog_name}
        COMMENT 'TotalEnergies Energy Market Intelligence Data Catalog'
    """)
    print(f"✅ Catalog '{catalog_name}' created/verified")
except Exception as e:
    print(f"❌ Error creating catalog: {e}")

# Set current catalog
spark.sql(f"USE CATALOG {catalog_name}")

# Create schema
try:
    spark.sql(f"""
        CREATE SCHEMA IF NOT EXISTS {catalog_name}.{schema_name}
        COMMENT 'Schema for energy market data, analytics, and ML models'
    """)
    print(f"✅ Schema '{catalog_name}.{schema_name}' created/verified")
except Exception as e:
    print(f"❌ Error creating schema: {e}")

# Set current schema
spark.sql(f"USE SCHEMA {schema_name}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## Create Volumes for Data Storage

# COMMAND ----------

# Create main data volume
try:
    spark.sql(f"""
        CREATE VOLUME IF NOT EXISTS {catalog_name}.{schema_name}.{volume_name}
        COMMENT 'Main volume for energy market data storage including raw, processed, and model artifacts'
    """)
    print(f"✅ Volume '{catalog_name}.{schema_name}.{volume_name}' created/verified")
except Exception as e:
    print(f"❌ Error creating volume: {e}")

# Create additional volumes for specific use cases
volumes_config = [
    ("demo_data", "Volume for synthetic demo data"),
    ("ml_models", "Volume for ML model artifacts and experiments"),
    ("logs", "Volume for application and pipeline logs"),
    ("external_feeds", "Volume for external data feeds and API responses")
]

for vol_name, description in volumes_config:
    try:
        spark.sql(f"""
            CREATE VOLUME IF NOT EXISTS {catalog_name}.{schema_name}.{vol_name}
            COMMENT '{description}'
        """)
        print(f"✅ Volume '{catalog_name}.{schema_name}.{vol_name}' created/verified")
    except Exception as e:
        print(f"❌ Error creating volume {vol_name}: {e}")

# COMMAND ----------

