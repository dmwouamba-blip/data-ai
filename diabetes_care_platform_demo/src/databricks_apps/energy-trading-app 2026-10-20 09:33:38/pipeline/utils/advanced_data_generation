    def generate_pnl_data(self, target_date: str, trades: List[Dict], positions: List[Dict]) -> List[Dict]:
        """Generate P&L data based on trades and positions"""
        
        pnl_records = []
        
        # Group trades by product, portfolio, and trader
        trade_groups = {}
        for trade in trades:
            # Assign portfolio and trader for P&L calculation
            portfolio = random.choice(list(self.master_data.portfolios.keys()))
            trader_id = random.choice(list(self.master_data.traders.keys()))
            
            key = (trade['instrument'], portfolio, trader_id)
            if key not in trade_groups:
                trade_groups[key] = []
            trade_groups[key].append(trade)
        
        for (product, portfolio, trader_id), product_trades in trade_groups.items():
            self.pnl_counter += 1
            
            # Calculate P&L components
            total_trade_value = sum(
                float(t['quantity']) * float(t['price']) * (1 if t['side'] == 'BUY' else -1)
                for t in product_trades
            )
            
            # Base P&L (simplified - would be more complex in reality)
            base_pnl = total_trade_value * random.uniform(-0.02, 0.05)  # -2% to +5% return
            
            # P&L attribution
            realized_pnl = base_pnl * random.uniform(0.6, 0.9)
            unrealized_pnl = base_pnl - realized_pnl
            
            # Detailed attribution
            price_pnl = base_pnl * random.uniform(0.7, 0.9)
            volume_pnl = random.uniform(-abs(base_pnl) * 0.1, abs(base_pnl) * 0.1)
            basis_pnl = random.uniform(-abs(base_pnl) * 0.05, abs(base_pnl) * 0.05)
            fx_pnl = random.uniform(-abs(base_pnl) * 0.03, abs(base_pnl) * 0.03)
            
            # Carry and theta (for derivatives)
            carry_pnl = random.uniform(-1000, 2000)
            theta_pnl = random.uniform(-500, 500)
            
            # Fees and commissions
            trading_fees = len(product_trades) * random.uniform(100, 500)
            commission = total_trade_value * random.uniform(0.0001, 0.0005)
            
            # Net calculations
            gross_pnl = base_pnl
            net_pnl = gross_pnl - trading_fees - commission
            
            pnl_record = {
                'pnl_id': f'pnl_{self.pnl_counter:08d}',
                'date': target_date,
                'product': product,
                'pnl': round(net_pnl, 2),
                'portfolio': portfolio,
                'trader_id': trader_id,
                'book': random.choice(list(self.master_data.books.keys())),
                'currency': 'USD',
                'realized_pnl': round(realized_pnl, 2),
                'unrealized_pnl': round(unrealized_pnl, 2),
                'mark_to_market_pnl': round(base_pnl * 1.02, 2),
                'carry_pnl': round(carry_pnl, 2),
                'theta_pnl': round(theta_pnl, 2),
                'price_pnl': round(price_pnl, 2),
                'volume_pnl': round(volume_pnl, 2),
                'basis_pnl': round(basis_pnl, 2),
                'fx_pnl': round(fx_pnl, 2),
                'gross_pnl': round(gross_pnl, 2),
                'net_pnl': round(net_pnl, 2),
                'trading_fees': round(trading_fees, 2),
                'commission': round(commission, 2)
            }
            
            pnl_records.append(pnl_record)
        
        return pnl_records

