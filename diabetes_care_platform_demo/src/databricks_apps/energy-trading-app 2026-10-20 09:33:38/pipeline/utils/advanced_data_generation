class MarketDataGenerator:
    """Generate realistic market data with correlations and patterns"""
    
    def __init__(self, master_data: MasterDataGenerator, config: DataConfig):
        self.master_data = master_data
        self.config = config
        self.price_history = {}
        self._initialize_price_history()
    
    def _initialize_price_history(self):
        """Initialize price history for all instruments"""
        for instrument, params in self.master_data.instruments.items():
            self.price_history[instrument] = [params['base_price']]
    
    def generate_correlated_returns(self, timestamp: datetime) -> Dict[str, float]:
        """Generate correlated returns for all instruments"""
        
        # Time-based factors
        hour = timestamp.hour
        day_of_week = timestamp.weekday()
        day_of_year = timestamp.timetuple().tm_yday
        
        # Seasonal factor
        seasonal_factor = 1 + self.config.seasonal_amplitude * math.sin(2 * math.pi * day_of_year / 365)
        
        # Trading session factor
        if self.config.trading_hours_start <= hour <= self.config.trading_hours_end:
            session_factor = 1.0
        else:
            session_factor = 0.3
        
        # Weekend factor
        if day_of_week >= 5:  # Saturday = 5, Sunday = 6
            session_factor *= self.config.weekend_trading_factor
        
        # Generate base random shocks
        base_shocks = {}
        correlation_groups = {}
        
        # Group instruments by correlation
        for instrument, params in self.master_data.instruments.items():
            group = params['correlation_group']
            if group not in correlation_groups:
                correlation_groups[group] = []
            correlation_groups[group].append(instrument)
        
        # Generate correlated shocks by group
        group_shocks = {}
        for group in correlation_groups.keys():
            group_shocks[group] = np.random.normal(0, 1)
        
        # Generate individual returns
        returns = {}
        for instrument, params in self.master_data.instruments.items():
            group = params['correlation_group']
            
            # Correlated component
            correlated_shock = group_shocks[group] * self.config.correlation_strength
            
            # Idiosyncratic component
            idiosyncratic_shock = np.random.normal(0, 1) * (1 - self.config.correlation_strength)
            
            # Combined shock
            total_shock = correlated_shock + idiosyncratic_shock
            
            # Apply volatility and factors
            volatility = params['volatility'] * session_factor * seasonal_factor
            returns[instrument] = total_shock * volatility / math.sqrt(365 * 24)  # Hourly volatility
        
        return returns
    
    def get_current_prices(self, timestamp: datetime) -> Dict[str, float]:
        """Get current prices for all instruments"""
        
        # Generate returns
        returns = self.generate_correlated_returns(timestamp)
        
        # Update prices
        current_prices = {}
        for instrument in self.master_data.instruments.keys():
            last_price = self.price_history[instrument][-1]
            return_pct = returns[instrument]
            new_price = last_price * (1 + return_pct)
            
            # Ensure positive prices
            new_price = max(new_price, last_price * 0.5)
            
            # Update history
            self.price_history[instrument].append(new_price)
            
            # Keep only recent history (memory management)
            if len(self.price_history[instrument]) > 1000:
                self.price_history[instrument] = self.price_history[instrument][-500:]
            
            current_prices[instrument] = new_price
        
        return current_prices

