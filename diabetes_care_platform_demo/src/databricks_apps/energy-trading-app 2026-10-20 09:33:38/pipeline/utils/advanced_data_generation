def generate_complete_dataset(start_date: datetime, end_date: datetime) -> Dict[str, List[Dict]]:
    """Generate complete dataset for the specified date range"""
    
    print(f"🔄 Generating complete dataset from {start_date.strftime('%Y-%m-%d')} to {end_date.strftime('%Y-%m-%d')}")
    
    all_data = {
        'trades': [],
        'trading_activity_log': [],
        'positions': [],
        'var_results': [],
        'risk_activity_log': [],
        'compliance_events': [],
        'pnl': []
    }
    
    current_date = start_date
    day_count = 0
    total_days = (end_date - start_date).days
    
    while current_date <= end_date:
        day_count += 1
        
        # Progress indicator
        if day_count % 10 == 0 or day_count == total_days:
            progress = (day_count / total_days) * 100
            print(f"   📅 Processing day {day_count}/{total_days} ({progress:.1f}%): {current_date.strftime('%Y-%m-%d')}")
        
        # Adjust volumes for weekends
        is_weekend = current_date.weekday() >= 5
        volume_factor = config.weekend_trading_factor if is_weekend else 1.0
        
        # Generate daily data
        daily_trades = int(config.trades_per_day * volume_factor)
        daily_activities = int(config.activities_per_day * volume_factor)
        
        # 1. Generate trades
        trades = trading_generator.generate_trades(current_date, daily_trades)
        all_data['trades'].extend(trades)
        
        # 2. Generate trading activities
        activities = trading_generator.generate_trading_activities(current_date, daily_activities, trades)
        all_data['trading_activity_log'].extend(activities)
        
        # 3. Update positions from trades
        date_str = current_date.strftime('%Y-%m-%d')
        risk_generator.update_positions_from_trades(trades, date_str)
        
        # 4. Generate positions
        positions = risk_generator.generate_positions(date_str)
        all_data['positions'].extend(positions)
        
        # 5. Generate VaR results
        var_results = risk_generator.generate_var_results(date_str, positions)
        all_data['var_results'].extend(var_results)
        
        # 6. Generate risk activities
        risk_activities = risk_generator.generate_risk_activities(current_date, var_results, positions)
        all_data['risk_activity_log'].extend(risk_activities)
        
        # 7. Generate compliance events
        compliance_events = compliance_finance_generator.generate_compliance_events(current_date, trades, risk_activities)
        all_data['compliance_events'].extend(compliance_events)
        
        # 8. Generate P&L data
        pnl_data = compliance_finance_generator.generate_pnl_data(date_str, trades, positions)
        all_data['pnl'].extend(pnl_data)
        
        # Move to next day
        current_date += timedelta(days=1)
    
    # Summary
    total_records = sum(len(data) for data in all_data.values())
    print(f"\n✅ Dataset generation completed!")
    print(f"   📊 Total records generated: {total_records:,}")
    
    for table_name, data in all_data.items():
        print(f"      • {table_name}: {len(data):,} records")
    
    return all_data

