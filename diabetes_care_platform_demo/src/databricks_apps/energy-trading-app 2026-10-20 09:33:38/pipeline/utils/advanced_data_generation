class TradingDataGenerator:
    """Generate realistic trading data with business patterns"""
    
    def __init__(self, master_data: MasterDataGenerator, market_generator: MarketDataGenerator, config: DataConfig):
        self.master_data = master_data
        self.market_generator = market_generator
        self.config = config
        self.trade_counter = 0
        self.activity_counter = 0
    
    def generate_trades(self, target_date: datetime, num_trades: int) -> List[Dict]:
        """Generate realistic trades for a given date"""
        
        trades = []
        current_prices = self.market_generator.get_current_prices(target_date)
        
        for _ in range(num_trades):
            self.trade_counter += 1
            
            # Select trader and their characteristics
            trader_id = random.choice(list(self.master_data.traders.keys()))
            trader_info = self.master_data.traders[trader_id]
            
            # Select instrument based on trader specialization
            if trader_info['specialization'] == 'crude_oil':
                instrument_pool = ['WTI_CRUDE', 'BRENT_CRUDE', 'HEATING_OIL']
            elif trader_info['specialization'] == 'natural_gas':
                instrument_pool = ['NATURAL_GAS', 'LNG_JKM']
            elif trader_info['specialization'] == 'power':
                instrument_pool = ['ELECTRICITY_PJM', 'ELECTRICITY_ERCOT']
            elif trader_info['specialization'] == 'refined_products':
                instrument_pool = ['RBOB_GASOLINE', 'HEATING_OIL']
            else:
                instrument_pool = list(self.master_data.instruments.keys())
            
            instrument = random.choice(instrument_pool)
            instrument_params = self.master_data.instruments[instrument]
            
            # Select counterparty with risk consideration
            counterparty = random.choice(list(self.master_data.counterparties.keys()))
            counterparty_info = self.master_data.counterparties[counterparty]
            
            # Trade timing within business hours (with some after-hours)
            if random.random() < 0.8:  # 80% during business hours
                trade_hour = random.randint(self.config.trading_hours_start, self.config.trading_hours_end)
            else:
                trade_hour = random.choice([*range(0, self.config.trading_hours_start), 
                                          *range(self.config.trading_hours_end + 1, 24)])
            
            trade_minute = random.randint(0, 59)
            trade_second = random.randint(0, 59)
            
            trade_time = target_date.replace(hour=trade_hour, minute=trade_minute, second=trade_second)
            
            # Trade size based on trader level and risk appetite
            base_size = {
                'junior': (100, 1000),
                'senior': (500, 5000),
                'principal': (1000, 10000),
                'managing_director': (2000, 20000)
            }[trader_info['level']]
            
            quantity = random.uniform(*base_size) * trader_info['risk_appetite']
            quantity = round(quantity / instrument_params['contract_size']) * instrument_params['contract_size']
            
            # Price with realistic bid-ask spread
            market_price = current_prices[instrument]
            spread_pct = random.uniform(0.001, 0.005)  # 0.1% to 0.5% spread
            
            side = random.choice(['BUY', 'SELL'])
            if side == 'BUY':
                price = market_price * (1 + spread_pct / 2)
            else:
                price = market_price * (1 - spread_pct / 2)
            
            # Round to tick size
            tick_size = instrument_params['tick_size']
            price = round(price / tick_size) * tick_size
            
            # Settlement date
            trade_date = trade_time.strftime('%Y-%m-%d')
            settle_date = (trade_time + timedelta(days=random.randint(1, 3))).strftime('%Y-%m-%d')
            
            trade = {
                'trade_id': f'trade_{self.trade_counter:08d}',
                'instrument': instrument,
                'counterparty': counterparty,
                'side': side,
                'quantity': quantity,
                'price': price,
                'currency': instrument_params['currency'],
                'trade_date': trade_date,
                'settle_date': settle_date,
                'timestamp': trade_time.strftime('%Y-%m-%dT%H:%M:%SZ')
            }
            
            trades.append(trade)
        
        return trades
    
    def generate_trading_activities(self, target_date: datetime, num_activities: int, trades: List[Dict]) -> List[Dict]:
        """Generate trading activities related to trades and market events"""
        
        activities = []
        
        # Generate activities based on trades (60% of activities)
        trade_activities = int(num_activities * 0.6)
        for _ in range(trade_activities):
            if not trades:
                break
                
            self.activity_counter += 1
            
            # Select a related trade
            related_trade = random.choice(trades)
            
            # Activity timing (usually close to trade time)
            trade_time = datetime.fromisoformat(related_trade['timestamp'].replace('Z', '+00:00'))
            activity_time = trade_time + timedelta(minutes=random.randint(-30, 30))
            
            # Activity types based on trade characteristics
            if float(related_trade['quantity']) * float(related_trade['price']) > 1000000:  # Large trade
                activity_type = random.choice(['order_execution', 'risk_alert', 'compliance_check'])
            else:
                activity_type = random.choice(['order_execution', 'market_update', 'position_update'])
            
            # Status based on activity type
            if activity_type == 'order_execution':
                status = random.choices(['executed', 'pending', 'cancelled'], weights=[0.8, 0.15, 0.05])[0]
            else:
                status = random.choices(['completed', 'in_progress', 'pending'], weights=[0.7, 0.2, 0.1])[0]
            
            # Risk score based on trade size and counterparty
            trade_value = float(related_trade['quantity']) * float(related_trade['price'])
            counterparty_risk = self.master_data.counterparties[related_trade['counterparty']]['risk_weight']
            base_risk = min(trade_value / 10000000, 1.0)  # Normalize to $10M
            risk_score = (base_risk + counterparty_risk) / 2
            
            activity = {
                'activity_id': f'act_{self.activity_counter:08d}',
                'timestamp': activity_time.strftime('%Y-%m-%dT%H:%M:%SZ'),
                'activity_type': activity_type,
                'trader_id': random.choice(list(self.master_data.traders.keys())),
                'instrument': related_trade['instrument'],
                'action': related_trade['side'],
                'quantity': related_trade['quantity'],
                'price': related_trade['price'],
                'status': status,
                'compliance_check': random.choices([True, False], weights=[0.9, 0.1])[0],
                'risk_score': round(risk_score, 3),
                'category': 'trading',
                'severity': 'low' if risk_score < 0.3 else 'medium' if risk_score < 0.7 else 'high',
                'description': f'{activity_type.replace("_", " ").title()} for {related_trade["instrument"]}',
                'notes': f'Related to trade {related_trade["trade_id"]}'
            }
            
            activities.append(activity)
        
        # Generate independent market activities (40% of activities)
        market_activities = num_activities - trade_activities
        for _ in range(market_activities):
            self.activity_counter += 1
            
            activity_time = target_date + timedelta(
                hours=random.randint(0, 23),
                minutes=random.randint(0, 59),
                seconds=random.randint(0, 59)
            )
            
            activity_type = random.choice([
                'market_analysis', 'risk_monitoring', 'position_review',
                'limit_monitoring', 'hedging_operation', 'algorithmic_trade'
            ])
            
            instrument = random.choice(list(self.master_data.instruments.keys()))
            trader_id = random.choice(list(self.master_data.traders.keys()))
            
            activity = {
                'activity_id': f'act_{self.activity_counter:08d}',
                'timestamp': activity_time.strftime('%Y-%m-%dT%H:%M:%SZ'),
                'activity_type': activity_type,
                'trader_id': trader_id,
                'instrument': instrument,
                'action': random.choice(['MONITOR', 'ANALYZE', 'HEDGE', 'REBALANCE']),
                'quantity': None,
                'price': None,
                'status': random.choices(['completed', 'in_progress'], weights=[0.8, 0.2])[0],
                'compliance_check': True,
                'risk_score': round(random.uniform(0.1, 0.5), 3),
                'category': random.choice(['risk_management', 'analytics', 'monitoring']),
                'severity': random.choices(['low', 'medium'], weights=[0.8, 0.2])[0],
                'description': f'{activity_type.replace("_", " ").title()} for {instrument}',
                'notes': f'Routine {activity_type} activity'
            }
            
            activities.append(activity)
        
        return activities

