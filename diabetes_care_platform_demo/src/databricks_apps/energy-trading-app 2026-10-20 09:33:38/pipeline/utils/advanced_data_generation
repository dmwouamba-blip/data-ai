class RiskDataGenerator:
    """Generate realistic risk data with correlations to trading activity"""
    
    def __init__(self, master_data: MasterDataGenerator, config: DataConfig):
        self.master_data = master_data
        self.config = config
        self.position_counter = 0
        self.var_counter = 0
        self.risk_activity_counter = 0
        
        # Track positions for consistency
        self.current_positions = {}
    
    def update_positions_from_trades(self, trades: List[Dict], target_date: str):
        """Update positions based on trades"""
        
        date_positions = {}
        
        for trade in trades:
            key = (trade['instrument'], 'Energy_Portfolio')  # Simplified to one portfolio
            
            if key not in date_positions:
                date_positions[key] = {
                    'instrument': trade['instrument'],
                    'portfolio': 'Energy_Portfolio',
                    'quantity': 0,
                    'total_value': 0,
                    'trade_count': 0
                }
            
            # Update position
            trade_qty = float(trade['quantity'])
            trade_value = trade_qty * float(trade['price'])
            
            if trade['side'] == 'BUY':
                date_positions[key]['quantity'] += trade_qty
                date_positions[key]['total_value'] += trade_value
            else:
                date_positions[key]['quantity'] -= trade_qty
                date_positions[key]['total_value'] -= trade_value
            
            date_positions[key]['trade_count'] += 1
        
        # Store positions for this date
        self.current_positions[target_date] = date_positions
    
    def generate_positions(self, target_date: str) -> List[Dict]:
        """Generate position records for a given date"""
        
        positions = []
        
        if target_date not in self.current_positions:
            return positions
        
        for key, pos_data in self.current_positions[target_date].items():
            self.position_counter += 1
            
            instrument = pos_data['instrument']
            portfolio = pos_data['portfolio']
            quantity = pos_data['quantity']
            
            if abs(quantity) < 1:  # Skip very small positions
                continue
            
            # Market value calculation (simplified)
            instrument_params = self.master_data.instruments[instrument]
            estimated_price = instrument_params['base_price'] * random.uniform(0.95, 1.05)
            market_value = abs(quantity) * estimated_price
            
            # Unrealized P&L (simplified)
            unrealized_pnl = pos_data['total_value'] * random.uniform(-0.1, 0.1)
            
            position = {
                'position_id': f'pos_{self.position_counter:08d}',
                'date': target_date,
                'product': instrument,
                'quantity': round(quantity, 2),
                'portfolio': portfolio,
                'counterparty': random.choice(list(self.master_data.counterparties.keys())),
                'location': random.choice(list(self.master_data.locations.keys())),
                'book': random.choice(list(self.master_data.books.keys())),
                'currency': instrument_params['currency'],
                'market_value': round(market_value, 2),
                'unrealized_pnl': round(unrealized_pnl, 2)
            }
            
            positions.append(position)
        
        return positions
    
    def generate_var_results(self, target_date: str, positions: List[Dict]) -> List[Dict]:
        """Generate VaR results based on positions"""
        
        var_results = []
        
        if not positions:
            return var_results
        
        # Group positions by product and portfolio
        position_groups = {}
        for pos in positions:
            key = (pos['product'], pos['portfolio'])
            if key not in position_groups:
                position_groups[key] = []
            position_groups[key].append(pos)
        
        for (product, portfolio), pos_list in position_groups.items():
            self.var_counter += 1
            
            # Calculate VaR based on position size and instrument volatility
            total_market_value = sum(float(pos['market_value']) for pos in pos_list)
            
            if total_market_value < 10000:  # Skip small positions
                continue
            
            instrument_params = self.master_data.instruments[product]
            volatility = instrument_params['volatility']
            
            # VaR calculation (simplified Monte Carlo approach)
            daily_vol = volatility / math.sqrt(252)  # Daily volatility
            var_95 = total_market_value * daily_vol * 1.645  # 95% VaR
            var_99 = total_market_value * daily_vol * 2.326  # 99% VaR
            expected_shortfall = var_99 * 1.3  # Simplified ES
            
            var_result = {
                'var_id': f'var_{self.var_counter:08d}',
                'date': target_date,
                'product': product,
                'var_95': round(var_95, 2),
                'var_99': round(var_99, 2),
                'portfolio': portfolio,
                'expected_shortfall': round(expected_shortfall, 2),
                'confidence_level': 0.95,
                'calculation_method': random.choice(['historical', 'parametric', 'monte_carlo']),
                'time_horizon_days': 1
            }
            
            var_results.append(var_result)
        
        return var_results
    
    def generate_risk_activities(self, target_date: datetime, var_results: List[Dict], positions: List[Dict]) -> List[Dict]:
        """Generate risk management activities"""
        
        activities = []
        
        # Risk activities based on VaR breaches
        for var_result in var_results:
