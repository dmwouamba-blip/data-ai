class EnergyMarketDataGenerator:
    """Generates comprehensive synthetic energy market data for demo purposes"""
    
    def __init__(self):
        self.start_date = datetime.now(timezone.utc) - timedelta(days=30)
        self.end_date = datetime.now(timezone.utc)
        
        # Market parameters (from original version)
        self.markets = {
            'epex_spot': {'base_price': 45.0, 'volatility': 0.15, 'timezone': 'Europe/Berlin'},
            'ice_endex': {'base_price': 48.5, 'volatility': 0.12, 'timezone': 'Europe/London'},
            'nord_pool': {'base_price': 42.0, 'volatility': 0.18, 'timezone': 'Europe/Oslo'},
            'pjm': {'base_price': 35.0, 'volatility': 0.20, 'timezone': 'America/New_York'},
            'eex': {'base_price': 46.8, 'volatility': 0.14, 'timezone': 'Europe/Berlin'}
        }
        
        self.traders = {
            'geneva': ['Marie Dubois', 'Hans Mueller', 'Anna Kowalski', 'Luca Rossi'],
            'houston': ['John Smith', 'Maria Garcia', 'David Johnson', 'Lisa Wong'],
            'singapore': ['Li Wei', 'Raj Patel', 'Sarah Kim', 'Ahmed Hassan'],
            'dubai': ['Omar Al-Rashid', 'Fatima Al-Zahra', 'Khalil Mansour', 'Leila Nazari']
        }
        
        # Market instruments
        self.instruments = [
            'WTI_CRUDE', 'BRENT_CRUDE', 'NATURAL_GAS', 'HEATING_OIL', 
            'RBOB_GASOLINE', 'COAL', 'ELECTRICITY', 'CARBON_CREDITS'
        ]
        
        # Counterparties
        self.counterparties = [
            'Goldman_Sachs', 'JPMorgan', 'Shell_Trading', 'BP_Energy',
            'Total_Gas_Power', 'Vitol', 'Glencore', 'Trafigura'
        ]

    def generate_market_prices(self, market: str, days: int = 30) -> pd.DataFrame:
        """Generate synthetic market price data"""
        market_config = self.markets[market]
        tz = pytz.timezone(market_config['timezone'])
        
        timestamps = []
        current = self.start_date.astimezone(tz)
        
        while current <= self.end_date.astimezone(tz):
            if 6 <= current.hour <= 22:  # Trading hours
                timestamps.append(current)
            current += timedelta(minutes=15)
        
        base_price = market_config['base_price']
        volatility = market_config['volatility']
        
        prices, volumes = [], []
        for i, ts in enumerate(timestamps):
            hour_factor = 1 + 0.3 * np.sin(2 * np.pi * ts.hour / 24)
            day_factor = 1 + 0.1 * np.sin(2 * np.pi * ts.weekday() / 7)
            
            if i == 0:
                price = base_price * hour_factor * day_factor
            else:
                price_change = np.random.normal(0, volatility * base_price / 100)
                price = python_max(0.0, prices[-1] + price_change)
            
            base_volume = random.uniform(800, 1200)
            volume_factor = 1.5 if i > 0 and python_abs(price - prices[-1]) > prices[-1] * 0.05 else 1
            
            prices.append(price)
            volumes.append(base_volume * volume_factor * hour_factor)
        
        return pd.DataFrame({
            'timestamp': timestamps,
            'market': market,
            'price': prices,
            'volume': volumes,
            'currency': 'EUR' if market in ['epex_spot', 'eex'] else 'USD',
            'product': 'Power' if market in ['epex_spot', 'nord_pool', 'pjm'] else 'Gas',
            'delivery_start': timestamps,
            'delivery_end': [ts + timedelta(hours=1) for ts in timestamps],
            'bid_price': [p * 0.995 for p in prices],
            'ask_price': [p * 1.005 for p in prices],
            'last_trade_price': prices,
            'source_system': f'{market}_api'
        })

    def generate_arbitrage_opportunities(self) -> pd.DataFrame:
        """Generate arbitrage opportunities between markets"""
        opportunities = []
        markets = list(self.markets.keys())
        
        for _ in range(50):
            timestamp = self.start_date + timedelta(
                seconds=random.randint(0, int((self.end_date - self.start_date).total_seconds()))
            )
            
            market_buy = random.choice(markets)
            market_sell = random.choice([m for m in markets if m != market_buy])
            
            spread = random.uniform(0.5, 5.0)
            confidence = random.uniform(0.6, 0.95)
            volume_potential = random.uniform(100, 1000)
            profit_potential = spread * volume_potential * random.uniform(0.8, 1.2)
            
            opportunities.append({
                'timestamp': timestamp,
                'market_buy': market_buy,
                'market_sell': market_sell,
                'spread': spread,
                'confidence_score': confidence,
                'volume_potential': volume_potential,
                'profit_potential': profit_potential,
                'opportunity_id': f'arb_{opportunities.__len__()+1:04d}',
                'risk_assessment': 'Low' if confidence > 0.8 else 'Medium' if confidence > 0.7 else 'High',
                'execution_window': random.randint(5, 30)
            })
        
        return pd.DataFrame(opportunities)

    def generate_communications(self) -> pd.DataFrame:
        """Generate communication records"""
        communications = []
        channels = ['email', 'chat', 'phone', 'bloomberg', 'reuters']
        hubs = ['geneva', 'houston', 'singapore', 'dubai']
        priorities = ['low', 'medium', 'high']
        sentiments = ['positive', 'neutral', 'negative']
        
        for _ in range(100):
            timestamp = self.start_date + timedelta(
                seconds=random.randint(0, int((self.end_date - self.start_date).total_seconds()))
            )
            
            hub = random.choice(hubs)
            sender = random.choice(self.traders[hub])
            
            messages = [
                f"Market update from {hub}: prices showing volatility",
                f"Risk alert: position limits approaching in {random.choice(list(self.markets.keys()))}",
                f"Trading opportunity identified in European markets",
                f"Regulatory update affecting {random.choice(['EPEX', 'ICE', 'Nord Pool'])} operations",
                f"Client inquiry about hedging strategies for Q{random.randint(1,4)}"
            ]
            
            message = random.choice(messages)
            keywords = ['trading', 'risk', 'market', 'price', 'volatility', 'opportunity']
            
            communications.append({
                'timestamp': timestamp,
                'channel': random.choice(channels),
                'sender': sender,
                'hub': hub,
                'message': message,
                'priority': random.choice(priorities),
                'keywords': random.sample(keywords, k=random.randint(2, 4)),
                'sentiment': random.choice(sentiments),
                'message_id': f'msg_{communications.__len__()+1:06d}',
                'market_impact': random.choice(['Low', 'Medium', 'High'])
            })
        
        return pd.DataFrame(communications)

    def generate_trades(self, num_trades: int = 150) -> pd.DataFrame:
        """Generate synthetic trades"""
        trades = []
        
        for i in range(num_trades):
            trade_date = self.start_date + timedelta(
                days=random.randint(0, (self.end_date - self.start_date).days)
            )
            
            trade = {
                'trade_id': f'trade_{i+1:06d}',
                'instrument': random.choice(self.instruments),
                'counterparty': random.choice(self.counterparties),
                'side': random.choice(['BUY', 'SELL']),
                'quantity': python_round(random.uniform(100, 10000), 2),
                'price': python_round(random.uniform(20, 100), 2),
                'currency': 'USD',
                'trade_date': trade_date.strftime('%Y-%m-%d'),
                'settle_date': (trade_date + timedelta(days=random.randint(1, 3))).strftime('%Y-%m-%d'),
                'timestamp': trade_date.strftime('%Y-%m-%dT%H:%M:%SZ')
            }
            trades.append(trade)
        
        return pd.DataFrame(trades)

