def create_silver_trades():
    """
    Transform bronze trades to silver layer with business logic and data quality improvements
    """
    print("🔄 Processing trades to silver layer...")
    
    # Read bronze trades
    bronze_trades = spark.table(f"{catalog_name}.{schema_name}.trades")
    
    # Apply business logic and data quality improvements
    silver_trades = (bronze_trades
        # Data quality filters
        .filter(col("trade_id").isNotNull())
        .filter(col("quantity") > 0)
        .filter(col("price") > 0)
        .filter(col("timestamp").isNotNull())
        
        # Business enrichments
        .withColumn("trade_value", col("quantity") * col("price"))
        .withColumn("settlement_date_calculated", 
            date_add(to_date(col("trade_date")), business_config["business_rules"]["settlement_days"]))
        
        # Trading session classification
        .withColumn("trading_session",
            when(hour(to_timestamp(col("timestamp"))).between(
                business_config["business_rules"]["trading_hours_start"], 
                business_config["business_rules"]["trading_hours_end"]), "Regular")
            .otherwise("Extended"))
        
        # Risk categorization based on trade value
        .withColumn("risk_category",
            when(col("trade_value") >= 10000000, "High")
            .when(col("trade_value") >= 1000000, "Medium")
            .otherwise("Low"))
        
        # Currency normalization to USD
        .withColumn("trade_value_usd",
            when(col("currency") == "USD", col("trade_value"))
            .when(col("currency") == "EUR", col("trade_value") * lit(business_config["fx_rates"]["EUR_USD"]))
            .when(col("currency") == "GBP", col("trade_value") * lit(business_config["fx_rates"]["GBP_USD"]))
            .otherwise(col("trade_value")))
        
        # Data quality score
        .withColumn("data_quality_score",
            when((col("settle_date").isNotNull()) & 
                 (col("counterparty").isNotNull()) & 
                 (col("trade_value") > 0), 1.0)
            .when(col("trade_value") > 0, 0.8)
            .otherwise(0.6))
        
        # Processing metadata
        .withColumn("processed_at", current_timestamp())
        .withColumn("processing_layer", lit("silver"))
    )
    
    # Write to silver table
    (silver_trades
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_trades"))
    
    count = silver_trades.count()
    print(f"✅ Silver trades: {count:,} records processed")
    return count

def create_silver_positions():
    """
    Transform bronze positions to silver layer with portfolio analytics
    """
    print("🔄 Processing positions to silver layer...")
    
    # Read bronze positions
    bronze_positions = spark.table(f"{catalog_name}.{schema_name}.positions")
    
    # Calculate portfolio-level metrics
    portfolio_metrics = (bronze_positions
        .groupBy("portfolio", "date")
        .agg(
            sum("market_value").alias("portfolio_market_value"),
            sum("unrealized_pnl").alias("portfolio_unrealized_pnl"),
            spark_count("*").alias("position_count"),
            sum(abs(col("quantity"))).alias("total_gross_position")
        ))
    
    # Join with portfolio metrics and enrich
    silver_positions = (bronze_positions
        .join(portfolio_metrics, ["portfolio", "date"], "left")
        
        # Position analytics
        .withColumn("position_value_usd", 
            when(col("currency") == "USD", col("market_value"))
            .otherwise(col("market_value") * lit(business_config["fx_rates"]["EUR_USD"])))
        
        .withColumn("portfolio_weight", 
            when(col("portfolio_market_value") > 0, 
                 col("market_value") / col("portfolio_market_value"))
            .otherwise(0))
        
        .withColumn("position_pnl_contribution",
            when(col("portfolio_unrealized_pnl") != 0,
                 col("unrealized_pnl") / col("portfolio_unrealized_pnl"))
            .otherwise(0))
        
        # Risk indicators
        .withColumn("large_position_flag",
            col("market_value") > lit(business_config["risk_thresholds"]["position_limit"] * 0.1))
        
        .withColumn("concentration_risk",
            when(col("portfolio_weight") > 0.2, "High")
            .when(col("portfolio_weight") > 0.1, "Medium")
            .otherwise("Low"))
        
        # Data quality and processing metadata
        .withColumn("data_quality_score", 
            when(col("market_value").isNotNull() & col("quantity").isNotNull(), 1.0)
            .otherwise(0.8))
        .withColumn("processed_at", current_timestamp())
        .withColumn("processing_layer", lit("silver"))
    )
    
    # Write to silver table
    (silver_positions
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_positions"))
    
    count = silver_positions.count()
    print(f"✅ Silver positions: {count:,} records processed")
    return count

def create_silver_risk_activities():
    """
    Transform bronze risk activities to silver layer with enhanced risk analytics
    """
    print("🔄 Processing risk activities to silver layer...")
    
    # Read bronze risk activities
    bronze_risk = spark.table(f"{catalog_name}.{schema_name}.risk_activity_log")
    
    # Create risk scoring and enrichment
    silver_risk = (bronze_risk
        # Risk score normalization
        .withColumn("risk_score_normalized",
            when(col("metric_value").isNotNull() & col("threshold_value").isNotNull(),
                 col("metric_value") / col("threshold_value"))
            .otherwise(
                when(col("severity") == "critical", 1.0)
                .when(col("severity") == "high", 0.8)
                .when(col("severity") == "medium", 0.5)
                .otherwise(0.2)))
        
        # Breach analysis
        .withColumn("threshold_breach",
            when(col("metric_value") > col("threshold_value"), True)
            .otherwise(False))
        
        .withColumn("breach_severity_score",
            when(col("threshold_breach") & (col("severity") == "critical"), 4)
            .when(col("threshold_breach") & (col("severity") == "high"), 3)
            .when(col("threshold_breach") & (col("severity") == "medium"), 2)
            .when(col("threshold_breach"), 1)
            .otherwise(0))
        
        # Time-based analysis
        .withColumn("activity_age_hours",
            (unix_timestamp(current_timestamp()) - unix_timestamp(to_timestamp(col("timestamp")))) / 3600)
        
        .withColumn("urgency_factor",
            when((col("severity") == "critical") & (col("activity_age_hours") < 1), 1.0)
            .when((col("severity") == "high") & (col("activity_age_hours") < 4), 0.8)
            .when(col("activity_age_hours") < 24, 0.6)
            .otherwise(0.3))
        
        # Business impact assessment
        .withColumn("business_impact_score",
            col("risk_score_normalized") * col("urgency_factor") * col("breach_severity_score"))
        
        # Activity categorization
        .withColumn("requires_immediate_action",
            (col("severity") == "critical") | 
            (col("threshold_breach") & (col("activity_age_hours") < 2)))
        
        .withColumn("escalation_recommended",
            (col("business_impact_score") > 2.0) | 
            ((col("severity") == "high") & (col("activity_age_hours") > 8)))
        
        # Processing metadata
        .withColumn("processed_at", current_timestamp())
        .withColumn("processing_layer", lit("silver"))
    )
    
    # Write to silver table
    (silver_risk
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_risk_activity_log"))
    
    count = silver_risk.count()
    print(f"✅ Silver risk activities: {count:,} records processed")
    return count

def create_silver_pnl():
    """
    Transform bronze P&L to silver layer with performance analytics
    """
    print("🔄 Processing P&L to silver layer...")
    
    # Read bronze P&L
    bronze_pnl = spark.table(f"{catalog_name}.{schema_name}.pnl")
    
    # Calculate rolling metrics using window functions
    portfolio_window = Window.partitionBy("portfolio", "product").orderBy("date").rowsBetween(-6, 0)  # 7-day window
    trader_window = Window.partitionBy("trader_id", "product").orderBy("date").rowsBetween(-29, 0)    # 30-day window
    
    silver_pnl = (bronze_pnl
        # Rolling performance metrics
        .withColumn("pnl_7d_avg", avg("pnl").over(portfolio_window))
        .withColumn("pnl_7d_volatility", stddev("pnl").over(portfolio_window))
        .withColumn("pnl_30d_cumulative", sum("pnl").over(trader_window))
        
        # Performance ratios
        .withColumn("sharpe_ratio_7d",
            when(col("pnl_7d_volatility") > 0, col("pnl_7d_avg") / col("pnl_7d_volatility"))
            .otherwise(0))
        
        .withColumn("profit_factor",
            when(col("realized_pnl") < 0, abs(col("realized_pnl")) / greatest(abs(col("unrealized_pnl")), lit(1)))
            .otherwise(lit(None)))
        
        # P&L categorization
        .withColumn("pnl_category",
            when(col("pnl") > 100000, "Large Gain")
            .when(col("pnl") > 10000, "Gain")
            .when(col("pnl") > -10000, "Neutral")
            .when(col("pnl") > -100000, "Loss")
            .otherwise("Large Loss"))
        
        # Alert flags
        .withColumn("daily_pnl_alert",
            abs(col("pnl")) > lit(business_config["risk_thresholds"]["daily_pnl_alert"]))
        
        .withColumn("unusual_pnl_flag",
            when(col("pnl_7d_volatility") > 0,
                 abs(col("pnl") - col("pnl_7d_avg")) > (col("pnl_7d_volatility") * 2))
            .otherwise(False))
        
        # Attribution analysis
        .withColumn("primary_pnl_driver",
            when(abs(col("price_pnl")) > greatest(abs(col("volume_pnl")), abs(col("basis_pnl"))), "Price")
            .when(abs(col("volume_pnl")) > abs(col("basis_pnl")), "Volume")
            .otherwise("Basis"))
        
        # Currency normalization
        .withColumn("pnl_usd",
            when(col("currency") == "USD", col("pnl"))
            .otherwise(col("pnl") * lit(business_config["fx_rates"]["EUR_USD"])))
        
        # Processing metadata
        .withColumn("processed_at", current_timestamp())
        .withColumn("processing_layer", lit("silver"))
    )
    
    # Write to silver table
    (silver_pnl
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_pnl"))
    
    count = silver_pnl.count()
    print(f"✅ Silver P&L: {count:,} records processed")
    return count

def create_silver_compliance_events():
    """
    Transform bronze compliance events to silver layer with regulatory analytics
    """
    print("🔄 Processing compliance events to silver layer...")
    
    # Read bronze compliance events
    bronze_compliance = spark.table(f"{catalog_name}.{schema_name}.compliance_events")
    
    # Compliance scoring and analytics
    silver_compliance = (bronze_compliance
        # Compliance risk scoring
        .withColumn("compliance_risk_score",
            when(col("severity") == "high", 3)
            .when(col("severity") == "medium", 2)
            .otherwise(1))
        
        # Regulatory urgency
        .withColumn("regulatory_urgency",
            when(col("regulation_type").isin(["MiFID", "EMIR"]), "High")
            .when(col("regulation_type") == "Dodd-Frank", "Medium")
            .otherwise("Standard"))
        
        # Event age analysis
        .withColumn("event_age_hours",
            (unix_timestamp(current_timestamp()) - unix_timestamp(to_timestamp(col("timestamp")))) / 3600)
        
        .withColumn("sla_breach_risk",
            when((col("severity") == "high") & (col("event_age_hours") > 4), "Critical")
            .when((col("severity") == "medium") & (col("event_age_hours") > 24), "High")
            .when(col("event_age_hours") > 72, "Medium")
            .otherwise("Low"))
        
        # Investigation priority
        .withColumn("investigation_priority",
            when((col("compliance_risk_score") >= 3) & (col("regulatory_urgency") == "High"), "Immediate")
            .when(col("compliance_risk_score") >= 2, "High")
            .otherwise("Standard"))
        
        # Categorization for reporting
        .withColumn("requires_regulatory_notification",
            (col("severity") == "high") & 
            col("regulation_type").isin(["MiFID", "EMIR", "Dodd-Frank"]))
        
        .withColumn("potential_fine_risk",
            when((col("violation_type") == "unauthorized_trade") & (col("severity") == "high"), "High")
            .when(col("violation_type") == "reporting_delay", "Medium")
            .otherwise("Low"))
        
        # Processing metadata
        .withColumn("processed_at", current_timestamp())
        .withColumn("processing_layer", lit("silver"))
    )
    
    # Write to silver table
    (silver_compliance
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_compliance_events"))
    
    count = silver_compliance.count()
    print(f"✅ Silver compliance events: {count:,} records processed")
    return count

