def create_gold_trading_summary():
    """
    Create gold layer trading summary for dashboard consumption
    """
    print("🔄 Creating gold trading summary...")
    
    # Read silver trades
    silver_trades = spark.table(f"{catalog_name}.{schema_name}.silver_trades")
    
    # Daily trading summary
    daily_trading_summary = (silver_trades
        .groupBy("trade_date", "instrument", "counterparty")
        .agg(
            spark_count("*").alias("trade_count"),
            sum("quantity").alias("total_quantity"),
            sum("trade_value_usd").alias("total_value_usd"),
            avg("price").alias("avg_price"),
            spark_min("price").alias("min_price"),
            spark_max("price").alias("max_price"),
            sum(when(col("side") == "BUY", col("quantity")).otherwise(0)).alias("buy_quantity"),
            sum(when(col("side") == "SELL", col("quantity")).otherwise(0)).alias("sell_quantity"),
            avg("data_quality_score").alias("avg_data_quality")
            # Note: trader_id not available in trades table - would need join with trading_activity_log
        )
        .withColumn("net_quantity", col("buy_quantity") - col("sell_quantity"))
        .withColumn("price_range", col("max_price") - col("min_price"))
        .withColumn("price_volatility", col("price_range") / col("avg_price"))
        .withColumn("created_at", current_timestamp())
    )
    
    # Write to gold table
    (daily_trading_summary
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.gold_daily_trading_summary"))
    
    count = daily_trading_summary.count()
    print(f"✅ Gold daily trading summary: {count:,} records")
    return count

def create_gold_risk_dashboard():
    """
    Create gold layer risk dashboard metrics
    """
    print("🔄 Creating gold risk dashboard...")
    
    # Read silver tables
    silver_positions = spark.table(f"{catalog_name}.{schema_name}.silver_positions")
    silver_risk = spark.table(f"{catalog_name}.{schema_name}.silver_risk_activity_log")
    silver_pnl = spark.table(f"{catalog_name}.{schema_name}.silver_pnl")
    
    # Portfolio risk summary
    portfolio_risk_summary = (silver_positions
        .filter(col("date") == date_sub(current_date(), 0))  # Latest date
        .groupBy("portfolio")
        .agg(
            sum("position_value_usd").alias("total_exposure"),
            sum("unrealized_pnl").alias("total_unrealized_pnl"),
            spark_count("*").alias("position_count"),
            spark_max("large_position_flag").alias("has_large_positions"),
            avg("portfolio_weight").alias("avg_position_weight"),
            sum(when(col("concentration_risk") == "High", 1).otherwise(0)).alias("high_concentration_positions")
        )
    )
    
    # Risk activity summary
    risk_activity_summary = (silver_risk
        .filter(col("timestamp") >= date_sub(current_timestamp(), 7))  # Last 7 days
        .groupBy("portfolio", "activity_type")
        .agg(
            spark_count("*").alias("activity_count"),
            sum(when(col("requires_immediate_action"), 1).otherwise(0)).alias("immediate_action_count"),
            sum(when(col("escalation_recommended"), 1).otherwise(0)).alias("escalation_count"),
            avg("business_impact_score").alias("avg_business_impact"),
            spark_max("business_impact_score").alias("max_business_impact")
        )
    )
    
    # P&L risk metrics
    pnl_risk_summary = (silver_pnl
        .filter(col("date") >= date_sub(current_date(), 30))  # Last 30 days
        .groupBy("portfolio", "product")
        .agg(
            sum("pnl_usd").alias("total_pnl_30d"),
            avg("pnl_usd").alias("avg_daily_pnl"),
            stddev("pnl_usd").alias("pnl_volatility"),
            sum(when(col("daily_pnl_alert"), 1).otherwise(0)).alias("pnl_alert_days"),
            sum(when(col("unusual_pnl_flag"), 1).otherwise(0)).alias("unusual_pnl_days"),
            spark_max("pnl_usd").alias("max_daily_pnl"),
            spark_min("pnl_usd").alias("min_daily_pnl")
        )
        .withColumn("pnl_sharpe_ratio", 
            when(col("pnl_volatility") > 0, col("avg_daily_pnl") / col("pnl_volatility"))
            .otherwise(0))
    )
    
    # Combine into comprehensive risk dashboard
    risk_dashboard = (portfolio_risk_summary
        .join(risk_activity_summary.groupBy("portfolio")
              .agg(
                  sum("activity_count").alias("total_risk_activities"),
                  sum("immediate_action_count").alias("total_immediate_actions"),
                  sum("escalation_count").alias("total_escalations"),
                  spark_max("max_business_impact").alias("highest_business_impact")
              ), ["portfolio"], "left")
        .join(pnl_risk_summary.groupBy("portfolio")
              .agg(
                  sum("total_pnl_30d").alias("portfolio_pnl_30d"),
                  avg("pnl_sharpe_ratio").alias("avg_sharpe_ratio"),
                  sum("pnl_alert_days").alias("total_pnl_alert_days"),
                  spark_max("max_daily_pnl").alias("best_daily_pnl"),
                  spark_min("min_daily_pnl").alias("worst_daily_pnl")
              ), ["portfolio"], "left")
        .withColumn("risk_score_composite",
            (coalesce(col("total_immediate_actions"), lit(0)) * 0.4 +
             coalesce(col("total_escalations"), lit(0)) * 0.3 +
             coalesce(col("highest_business_impact"), lit(0)) * 0.2 +
             coalesce(col("total_pnl_alert_days"), lit(0)) * 0.1))
        .withColumn("created_at", current_timestamp())
    )
    
    # Write to gold table
    (risk_dashboard
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.gold_risk_dashboard"))
    
    count = risk_dashboard.count()
    print(f"✅ Gold risk dashboard: {count:,} records")
    return count

def create_gold_compliance_summary():
    """
    Create gold layer compliance summary for regulatory reporting
    """
    print("🔄 Creating gold compliance summary...")
    
    # Read silver compliance events
    silver_compliance = spark.table(f"{catalog_name}.{schema_name}.silver_compliance_events")
    
    # Compliance summary by regulation type
    compliance_summary = (silver_compliance
        .groupBy("regulation_type", "category", "status")
        .agg(
            spark_count("*").alias("event_count"),
            sum(when(col("severity") == "high", 1).otherwise(0)).alias("high_severity_count"),
            sum(when(col("requires_regulatory_notification"), 1).otherwise(0)).alias("notification_required_count"),
            sum(when(col("potential_fine_risk") == "High", 1).otherwise(0)).alias("high_fine_risk_count"),
            avg("compliance_risk_score").alias("avg_risk_score"),
            spark_max("event_age_hours").alias("oldest_event_hours"),
            sum(when(col("sla_breach_risk") == "Critical", 1).otherwise(0)).alias("sla_critical_count")
        )
        .withColumn("compliance_health_score",
