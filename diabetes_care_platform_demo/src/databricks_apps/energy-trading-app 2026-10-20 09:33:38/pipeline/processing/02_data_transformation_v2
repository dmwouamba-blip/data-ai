# Analyze and optimize all transformed tables
tables_to_optimize = [
    'silver_trades', 'silver_positions', 'silver_risk_activity_log', 
    'silver_pnl', 'silver_compliance_events',
    'gold_daily_trading_summary', 'gold_risk_dashboard', 'gold_compliance_summary'
]

optimization_results = []

for table in tables_to_optimize:
    try:
        # Get table statistics
        df = spark.table(f"{catalog_name}.{schema_name}.{table}")
        record_count = df.count()
        
        # Analyze table statistics
        spark.sql(f"ANALYZE TABLE {catalog_name}.{schema_name}.{table} COMPUTE STATISTICS")
        
        # Optimize with Z-ordering based on table type
        if 'trades' in table:
            spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table} ZORDER BY (instrument, trade_date)")
        elif 'positions' in table:
            spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table} ZORDER BY (portfolio, product, date)")
        elif 'risk' in table:
            if 'gold_risk_dashboard' in table:
                spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table} ZORDER BY (portfolio, activity_type)")
            else:
                spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table} ZORDER BY (activity_type, timestamp)")
        elif 'pnl' in table:
            spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table} ZORDER BY (portfolio, product, date)")
        elif 'compliance' in table:
            if 'gold_compliance_summary' in table:
                spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table} ZORDER BY (regulation_type, category)")
            else:
                spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table} ZORDER BY (regulation_type, timestamp)")
        else:
            spark.sql(f"OPTIMIZE {catalog_name}.{schema_name}.{table}")
        
        optimization_results.append({
            'table': table,
            'record_count': record_count,
            'status': 'optimized'
        })
        
        print(f"✅ Optimized {table}: {record_count:,} records")
        
    except Exception as e:
        print(f"⚠️  Optimization warning for {table}: {e}")
        optimization_results.append({
            'table': table,
            'record_count': 0,
            'status': 'failed'
        })

