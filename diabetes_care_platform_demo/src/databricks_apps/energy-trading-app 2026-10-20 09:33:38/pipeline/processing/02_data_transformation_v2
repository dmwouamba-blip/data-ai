            .when(col("high_fine_risk_count") > 0, 0.3)
            .when(col("notification_required_count") > 0, 0.6)
            .when(col("high_severity_count") > 0, 0.8)
            .otherwise(1.0))
        .withColumn("created_at", current_timestamp())
    )
    
    # Write to gold table
    (compliance_summary
     .write
     .mode("overwrite")
     .option("mergeSchema", "true")
     .saveAsTable(f"{catalog_name}.{schema_name}.gold_compliance_summary"))
    
    count = compliance_summary.count()
    print(f"✅ Gold compliance summary: {count:,} records")
    return count

