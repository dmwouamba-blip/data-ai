        COALESCE((SELECT SUM(trade_count) FROM {catalog_name}.{schema_name}.gold_daily_trading_summary 
                  WHERE trade_date = current_date()), 0) as trades_today,
        COALESCE((SELECT SUM(total_value_usd) FROM {catalog_name}.{schema_name}.gold_daily_trading_summary 
                  WHERE trade_date = current_date()), 0) as trading_volume_today,
        COALESCE((SELECT COUNT(DISTINCT instrument) FROM {catalog_name}.{schema_name}.gold_daily_trading_summary 
                  WHERE trade_date = current_date()), 0) as instruments_traded_today,
        
        -- Risk metrics (from gold risk dashboard)
        COALESCE((SELECT SUM(total_exposure) FROM {catalog_name}.{schema_name}.gold_risk_dashboard), 0) as total_exposure,
        COALESCE((SELECT SUM(total_immediate_actions) FROM {catalog_name}.{schema_name}.gold_risk_dashboard), 0) as active_risk_alerts,
        COALESCE((SELECT SUM(total_escalations) FROM {catalog_name}.{schema_name}.gold_risk_dashboard), 0) as critical_risk_alerts,
        
        -- P&L metrics (from silver P&L)
        COALESCE((SELECT SUM(pnl_usd) FROM {catalog_name}.{schema_name}.silver_pnl WHERE date = current_date()), 0) as pnl_today,
        COALESCE((SELECT SUM(pnl_usd) FROM {catalog_name}.{schema_name}.silver_pnl WHERE date >= date_sub(current_date(), 7)), 0) as pnl_week,
        COALESCE((SELECT SUM(pnl_usd) FROM {catalog_name}.{schema_name}.silver_pnl WHERE date >= date_sub(current_date(), 30)), 0) as pnl_month,
        
        -- Compliance metrics (from gold compliance summary)
        COALESCE((SELECT SUM(event_count) FROM {catalog_name}.{schema_name}.gold_compliance_summary 
                  WHERE status IN ('open', 'investigating')), 0) as open_compliance_events,
        COALESCE((SELECT SUM(high_severity_count) FROM {catalog_name}.{schema_name}.gold_compliance_summary 
                  WHERE status IN ('open', 'investigating')), 0) as high_severity_compliance
    """,
    
    # Recent trading activities view (matches API format)
    f"""
    CREATE OR REPLACE VIEW {catalog_name}.{schema_name}.v_recent_trading_activities AS
    SELECT 
        activity_id,
        timestamp,
        activity_type,
        trader_id,
        instrument,
        action,
        quantity,
        price,
        status,
        compliance_check,
        COALESCE(risk_score, 0.0) as risk_score
    FROM {catalog_name}.{schema_name}.trading_activity_log
    WHERE timestamp >= date_sub(current_timestamp(), 1)
    ORDER BY timestamp DESC
    LIMIT 100
    """,
    
    # Current positions view (matches Position schema)
    f"""
    CREATE OR REPLACE VIEW {catalog_name}.{schema_name}.v_current_positions AS
    SELECT 
        date,
        product,
        quantity,
        portfolio,
        market_value,
        unrealized_pnl
    FROM {catalog_name}.{schema_name}.silver_positions
    WHERE date = (SELECT MAX(date) FROM {catalog_name}.{schema_name}.silver_positions)
    ORDER BY product
    """,
    
    # Active compliance events view (matches ComplianceEvent schema)
    f"""
    CREATE OR REPLACE VIEW {catalog_name}.{schema_name}.v_active_compliance_events AS
    SELECT 
        event_id,
        timestamp,
        severity,
        category,
        message,
        status,
        product,
        counterparty,
        trader_id
    FROM {catalog_name}.{schema_name}.silver_compliance_events
    WHERE status IN ('open', 'investigating')
    ORDER BY severity DESC, timestamp DESC
    """,
    
    # Recent P&L view (matches PnL schema)
    f"""
    CREATE OR REPLACE VIEW {catalog_name}.{schema_name}.v_recent_pnl AS
    SELECT 
        date,
        product,
        pnl,
        portfolio,
        trader_id,
        realized_pnl,
        unrealized_pnl
    FROM {catalog_name}.{schema_name}.silver_pnl
    WHERE date >= date_sub(current_date(), 30)
    ORDER BY date DESC, product
    """,
    
    # Portfolio performance analytics
    f"""
    CREATE OR REPLACE VIEW {catalog_name}.{schema_name}.v_portfolio_performance AS
    SELECT 
        p.portfolio,
        p.total_exposure,
        p.total_unrealized_pnl,
        p.position_count,
        p.portfolio_pnl_30d,
        p.avg_sharpe_ratio,
        p.risk_score_composite,
        t.total_value_usd as trading_volume_30d,
        t.unique_traders,
        c.event_count as compliance_events_30d,
        c.compliance_health_score
    FROM {catalog_name}.{schema_name}.gold_risk_dashboard p
    LEFT JOIN (
        SELECT portfolio, SUM(total_value_usd) as total_value_usd, SUM(unique_traders) as unique_traders
        FROM {catalog_name}.{schema_name}.gold_daily_trading_summary 
        WHERE trade_date >= date_sub(current_date(), 30)
        GROUP BY portfolio
    ) t ON p.portfolio = t.portfolio
    LEFT JOIN (
        SELECT 'All' as portfolio, SUM(event_count) as event_count, AVG(compliance_health_score) as compliance_health_score
        FROM {catalog_name}.{schema_name}.gold_compliance_summary
    ) c ON 1=1
    ORDER BY p.risk_score_composite DESC
    """,
    
    # Real-time activity feed
    f"""
    CREATE OR REPLACE VIEW {catalog_name}.{schema_name}.v_realtime_activity_feed AS
    SELECT 
        'trading' as activity_category,
        activity_id as id,
        timestamp,
        activity_type,
        CONCAT(action, ' ', COALESCE(CAST(quantity AS STRING), ''), ' ', instrument) as description,
        trader_id as user_id,
        COALESCE(severity, 'medium') as severity,
        status
    FROM {catalog_name}.{schema_name}.trading_activity_log
    WHERE timestamp >= date_sub(current_timestamp(), 1)

    UNION ALL

    SELECT 
        'risk' as activity_category,
        activity_id as id,
        timestamp,
        activity_type,
        description,
        user_id,
        severity,
        status
    FROM {catalog_name}.{schema_name}.silver_risk_activity_log
    WHERE timestamp >= date_sub(current_timestamp(), 1)

    UNION ALL

    SELECT 
        'compliance' as activity_category,
        event_id as id,
        timestamp,
        category as activity_type,
        message as description,
        trader_id as user_id,
        severity,
        status
    FROM {catalog_name}.{schema_name}.silver_compliance_events
    WHERE timestamp >= date_sub(current_timestamp(), 1)

    ORDER BY timestamp DESC
    LIMIT 200
    """
]

