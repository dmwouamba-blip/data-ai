def create_silver_market_data():
    """
    Transform bronze market data to silver layer with:
    - Data quality improvements
    - Currency normalization
    - Time zone standardization
    - Price validation and outlier detection
    """
    
    markets = ["epex_spot", "ice_endex", "nord_pool", "pjm", "eex"]
    
    for market in markets:
        print(f"Processing {market} data...")
        
        # Read bronze data
        bronze_df = spark.table(f"{catalog_name}.{schema_name}.bronze_market_prices_{market}")
        
        # Data cleaning and validation
        silver_df = (bronze_df
            .filter(col("price").isNotNull() & (col("price") > 0))
            .filter(col("volume").isNotNull() & (col("volume") > 0))
            .filter(col("timestamp").isNotNull())
            
            # Currency normalization to USD
            .withColumn("price_usd", 
                when(col("currency") == "USD", col("price"))
                .when(col("currency") == "EUR", col("price") * lit(fx_rates["EUR_USD"]))
                .when(col("currency") == "GBP", col("price") * lit(fx_rates["GBP_USD"]))
                .when(col("currency") == "NOK", col("price") * lit(fx_rates["NOK_USD"]))
                .when(col("currency") == "SEK", col("price") * lit(fx_rates["SEK_USD"]))
                .when(col("currency") == "DKK", col("price") * lit(fx_rates["DKK_USD"]))
                .otherwise(col("price")))
            
            # Time zone standardization to UTC
            .withColumn("timestamp_utc", 
                when(col("market") == "pjm", 
                     from_utc_timestamp(col("timestamp"), "America/New_York"))
                .otherwise(from_utc_timestamp(col("timestamp"), "Europe/Berlin")))
            
            # Price validation and outlier detection
            .withColumn("is_outlier", 
                when(col("price") > (col("price") * 3), True)
                .when(col("price") < (col("price") * 0.1), True)
                .otherwise(False))
            
            # Add moving averages for trend analysis
            .withColumn("price_ma_1h", 
                avg("price").over(
                    Window.partitionBy("market")
                    .orderBy("timestamp")
                    .rowsBetween(-4, 0)))  # 4 periods = 1 hour (15min intervals)
            
            .withColumn("price_ma_24h", 
                avg("price").over(
                    Window.partitionBy("market")
                    .orderBy("timestamp")
                    .rowsBetween(-96, 0)))  # 96 periods = 24 hours
            
            # Calculate price volatility
            .withColumn("price_volatility", 
                stddev("price").over(
                    Window.partitionBy("market")
                    .orderBy("timestamp")
                    .rowsBetween(-96, 0)))
            
            # Trading session identification
            .withColumn("trading_session",
                when(hour(col("timestamp")).between(6, 18), "Day")
                .when(hour(col("timestamp")).between(19, 22), "Evening")
                .otherwise("Night"))
            
            # Data quality score enhancement
            .withColumn("enhanced_quality_score",
                when(col("is_outlier") == True, 0.3)
                .when(col("price_volatility") > (col("price") * 0.5), 0.7)
                .when(col("volume") < 10, 0.8)
                .otherwise(1.0))
        )
        
        # Create silver table
        (silver_df
         .write
         .mode("overwrite")
         .option("mergeSchema", "true")
         .saveAsTable(f"{catalog_name}.{schema_name}.silver_market_prices_{market}"))
        
        record_count = silver_df.count()
        quality_records = silver_df.filter(col("enhanced_quality_score") == 1.0).count()
        print(f"  Created silver table: {record_count:,} records ({quality_records/record_count*100:.1f}% high quality)")

create_silver_market_data()

