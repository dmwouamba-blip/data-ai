def create_gold_layer_analytics():
    """
    Create gold layer tables for business analytics and reporting
    """
    
    # 1. Hourly Market Summary
    hourly_summary = (spark.table(f"{catalog_name}.{schema_name}.silver_unified_markets")
        .groupBy("market", "trading_session", 
                date_trunc("hour", "timestamp_utc").alias("hour"))
        .agg(
            avg("price_usd").alias("avg_price_usd"),
            min("price_usd").alias("min_price_usd"),
            max("price_usd").alias("max_price_usd"),
            sum("volume").alias("total_volume"),
            stddev("price_usd").alias("price_volatility"),
            count("*").alias("data_points"),
            avg("enhanced_quality_score").alias("avg_quality_score")
        )
        .withColumn("price_range", col("max_price_usd") - col("min_price_usd"))
        .withColumn("volume_weighted_price", 
            sum(col("avg_price_usd") * col("total_volume")).over(
                Window.partitionBy("hour")) / 
            sum("total_volume").over(Window.partitionBy("hour")))
    )
    
    (hourly_summary
     .write
     .mode("overwrite")
     .saveAsTable(f"{catalog_name}.{schema_name}.gold_hourly_market_summary"))
    
    # 2. Trading Hub Performance
    comm_df = spark.table(f"{catalog_name}.{schema_name}.silver_communications").alias("comm")
    arb_df = spark.table(f"{catalog_name}.{schema_name}.silver_arbitrage_opportunities").alias("arb")
    
    hub_performance = (
        comm_df
        .join(
            arb_df,
            date_trunc("hour", comm_df.timestamp) == date_trunc("hour", arb_df.timestamp),
            how="left"
        )
        .groupBy("hub", date_trunc("day", comm_df.timestamp).alias("trading_date"))
        .agg(
            count("message_id").alias("total_communications"),
            sum(when(col("urgency_score") > 0.7, 1).otherwise(0)).alias("urgent_communications"),
            sum("profit_potential").alias("total_profit_potential"),
            avg("opportunity_score").alias("avg_opportunity_score"),
            countDistinct("market_buy", "market_sell").alias("unique_arbitrage_pairs")
        )
        .withColumn("communication_efficiency", 
            col("urgent_communications") / col("total_communications"))
        .withColumn("profit_per_communication", 
            col("total_profit_potential") / col("total_communications"))
    )
    
    (hub_performance
     .write
     .mode("overwrite")
     .saveAsTable(f"{catalog_name}.{schema_name}.gold_trading_hub_performance"))
    
    # 3. Cross-Market Arbitrage Dashboard
    arbitrage_dashboard = (
        spark.table(f"{catalog_name}.{schema_name}.silver_arbitrage_opportunities")
        .filter(col("opportunity_score") > 0.5)
        .groupBy("market_buy", "market_sell", 
                date_trunc("hour", col("timestamp")).alias("hour"))
        .agg(
            count("*").alias("opportunity_count"),
            avg("spread").alias("avg_spread"),
            sum("profit_potential").alias("total_profit_potential"),
            avg("confidence_score").alias("avg_confidence"),
            avg("opportunity_score").alias("avg_opportunity_score")
        )
        .withColumn("market_pair", concat(col("market_buy"), lit(" -> "), col("market_sell")))
        .withColumn("profitability_rank", 
            row_number().over(
                Window.partitionBy("hour")
                .orderBy(desc("total_profit_potential"))))
    )
    
    (arbitrage_dashboard
     .write
     .mode("overwrite")
     .saveAsTable(f"{catalog_name}.{schema_name}.gold_arbitrage_dashboard"))
    
    # 4. Market Intelligence Summary
    intelligence_summary = (
        spark.table(f"{catalog_name}.{schema_name}.silver_communications")
        .filter(col("intelligence_score") > 0.5)
        .groupBy(date_trunc("hour", col("timestamp")).alias("hour"))
        .agg(
            count("*").alias("total_intel_messages"),
            avg("intelligence_score").alias("avg_intelligence_score"),
            sum(when(col("price_direction_signal") == "UP", 1).otherwise(0)).alias("bullish_signals"),
            sum(when(col("price_direction_signal") == "DOWN", 1).otherwise(0)).alias("bearish_signals"),
            sum(when(col("requires_coordination"), 1).otherwise(0)).alias("coordination_required"),
            collect_set("hub").alias("active_hubs"),
            size(collect_set("mentioned_markets")).alias("markets_mentioned")
        )
        .withColumn("market_sentiment", 
            when(col("bullish_signals") > col("bearish_signals"), "Bullish")
            .when(col("bearish_signals") > col("bullish_signals"), "Bearish")
            .otherwise("Neutral"))
        .withColumn("coordination_ratio", 
            col("coordination_required") / col("total_intel_messages"))
    )
    
    (intelligence_summary
     .write
     .mode("overwrite")
     .saveAsTable(f"{catalog_name}.{schema_name}.gold_market_intelligence_summary"))
    
    print("Gold layer analytics tables created successfully:")
    print("  - gold_hourly_market_summary")
    print("  - gold_trading_hub_performance") 
    print("  - gold_arbitrage_dashboard")
    print("  - gold_market_intelligence_summary")

create_gold_layer_analytics()

