def create_unified_market_view():
    """
    Create a unified view combining all markets for cross-market analysis
    """
    
    markets = ["epex_spot", "ice_endex", "nord_pool", "pjm", "eex"]
    market_dfs = []
    
    for market in markets:
        df = (spark.table(f"{catalog_name}.{schema_name}.silver_market_prices_{market}")
              .select("timestamp_utc", "market", "price", "price_usd", "volume", 
                     "currency", "product", "trading_session", "enhanced_quality_score"))
        market_dfs.append(df)
    
    # Union all market data
    unified_df = market_dfs[0]
    for df in market_dfs[1:]:
        unified_df = unified_df.union(df)
    
    # Add cross-market analytics
    cross_market_df = (unified_df
        .withColumn("global_avg_price", 
            avg("price_usd").over(
                Window.partitionBy("trading_session")
                .orderBy("timestamp_utc")
                .rowsBetween(-10, 0)))
        
        .withColumn("market_premium", 
            col("price_usd") - col("global_avg_price"))
        
        .withColumn("relative_volume", 
            col("volume") / sum("volume").over(
                Window.partitionBy("trading_session", "timestamp_utc")))
        
        # Market correlation indicators
        .withColumn("price_rank", 
            row_number().over(
                Window.partitionBy("timestamp_utc")
                .orderBy(desc("price_usd"))))
    )
    
    # Save unified market view
    (cross_market_df
     .write
     .mode("overwrite")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_unified_markets"))
    
    print(f"Created unified market view: {cross_market_df.count():,} records")

create_unified_market_view()

