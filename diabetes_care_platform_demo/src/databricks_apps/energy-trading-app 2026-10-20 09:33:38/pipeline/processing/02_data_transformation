def enhance_arbitrage_opportunities():
    """
    Enhance arbitrage opportunities with real-time validation and risk assessment
    """
    
    # Read bronze arbitrage data
    arbitrage_df = spark.table(f"{catalog_name}.{schema_name}.bronze_arbitrage_opportunities")
    
    # Get current market prices for validation
    current_prices = (spark.table(f"{catalog_name}.{schema_name}.silver_unified_markets")
                     .groupBy("market")
                     .agg(
                         max("timestamp_utc").alias("latest_timestamp"),
                         last("price_usd").alias("current_price"),
                         avg("price_volatility").alias("avg_volatility")
                     ))
    
    # Enhance arbitrage opportunities
    enhanced_arbitrage = (arbitrage_df
        # Add risk scoring
        .withColumn("risk_score",
            when(col("confidence_score") > 0.9, 1)  # Low risk
            .when(col("confidence_score") > 0.7, 2)  # Medium risk
            .otherwise(3))  # High risk
        
        # Calculate potential ROI
        .withColumn("roi_percentage", 
            (col("profit_potential") / (col("volume_potential") * 50)) * 100)  # Assuming 50 USD/MWh base
        
        # Add execution priority
        .withColumn("execution_priority",
            when((col("profit_potential") > 1000) & (col("confidence_score") > 0.8), "High")
            .when((col("profit_potential") > 500) & (col("confidence_score") > 0.6), "Medium")
            .otherwise("Low"))
        
        # Add market conditions assessment
        .withColumn("market_conditions",
            when(hour(col("timestamp")).between(8, 18), "Active Trading")
            .when(hour(col("timestamp")).between(19, 23), "Evening")
            .otherwise("Overnight"))
        
        # Calculate time decay factor
        .withColumn("time_since_detection", 
            (unix_timestamp(current_timestamp()) - unix_timestamp(col("timestamp"))) / 60)  # minutes
        
        .withColumn("opportunity_decay", 
            greatest(lit(0), lit(1) - (col("time_since_detection") / 30)))  # Decay over 30 minutes
        
        # Final opportunity score
        .withColumn("opportunity_score", 
            col("confidence_score") * col("opportunity_decay") * 
            when(col("execution_priority") == "High", 1.2)
            .when(col("execution_priority") == "Medium", 1.0)
            .otherwise(0.8))
    )
    
    # Save enhanced arbitrage opportunities
    (enhanced_arbitrage
     .write
     .mode("overwrite")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_arbitrage_opportunities"))
    
    print(f"Enhanced arbitrage opportunities: {enhanced_arbitrage.count():,} records")

enhance_arbitrage_opportunities()

