def process_communication_intelligence():
    """
    Process communications to extract market-relevant intelligence
    """
    
    # Read bronze communications
    comm_df = spark.table(f"{catalog_name}.{schema_name}.bronze_communications")
    
    # Enhanced communication processing
    enhanced_comm = (comm_df
        # Extract market mentions from message text
        .withColumn("mentioned_markets", 
            array_distinct(
                filter(
                    array(lit("epex"), lit("ice"), lit("nord"), lit("pjm"), lit("eex")),
                    lambda x: lower(col("message")).contains(x)
                )
            ))
        
        # Extract urgency indicators
        .withColumn("urgency_score",
            when(lower(col("message")).contains("urgent"), 0.9)
            .when(lower(col("message")).contains("alert"), 0.8)
            .when(lower(col("message")).contains("breaking"), 0.85)
            .when(col("priority") == "high", 0.7)
            .otherwise(0.3))
        
        # Extract price movement indicators
        .withColumn("price_direction_signal",
            when(lower(col("message")).rlike("(spike|surge|jump|soar)"), "UP")
            .when(lower(col("message")).rlike("(drop|fall|crash|plunge)"), "DOWN")
            .when(lower(col("message")).rlike("(volatile|swing|fluctuat)"), "VOLATILE")
            .otherwise("NEUTRAL"))
        
        # Time-based relevance
        .withColumn("message_age_hours", 
            (unix_timestamp(current_timestamp()) - unix_timestamp(col("timestamp"))) / 3600)
        
        .withColumn("relevance_score",
            greatest(lit(0), lit(1) - (col("message_age_hours") / 24)))  # Decay over 24 hours
        
        # Overall intelligence score
        .withColumn("intelligence_score",
            col("urgency_score") * col("relevance_score") * 
            when(size(col("mentioned_markets")) > 0, 1.2).otherwise(1.0))
        
        # Hub coordination indicator
        .withColumn("requires_coordination",
            when((col("intelligence_score") > 0.7) & (size(col("mentioned_markets")) > 1), True)
            .otherwise(False))
    )
    
    # Save enhanced communications
    (enhanced_comm
     .write
     .mode("overwrite")
     .saveAsTable(f"{catalog_name}.{schema_name}.silver_communications"))
    
    print(f"Processed communications: {enhanced_comm.count():,} records")

process_communication_intelligence()

