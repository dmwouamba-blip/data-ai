# ================================
# ENVIRONMENT CONFIGURATION
# ================================
ENVIRONMENT=local

# CORS Configuration pour le développement local
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Répertoire des données de test (pour le mode local)
MOCK_DATA_DIR=infra/local/mock

# ================================
# DATABRICKS CONFIGURATION
# ================================

# 🏢 Workspace Databricks (REQUIS)
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# 🔐 Authentification (CHOISIR UNE MÉTHODE)

# Option 1: Service Principal (RECOMMANDÉ pour production et développement)
DATABRICKS_CLIENT_ID=your-service-principal-client-id
DATABRICKS_CLIENT_SECRET=your-service-principal-client-secret

# Option 2: Token Personnel (pour tests rapides uniquement)
# DATABRICKS_TOKEN=your-personal-access-token

# 🤖 Configuration AgentBricks
AGENTBRICKS_ENDPOINT=your-agentbricks-endpoint-name

# ================================
# INSTRUCTIONS RAPIDES
# ================================
# 
# 🚀 DÉVELOPPEMENT LOCAL:
# 1. Copiez ce fichier: cp example.env .env
# 2. Remplacez les valeurs par vos vrais identifiants
# 3. Préférez toujours SERVICE PRINCIPAL (CLIENT_ID/CLIENT_SECRET)
#
# 🚢 DÉPLOIEMENT:
# 1. Utilisez les variables d'environnement de votre plateforme
# 2. OBLIGATOIRE: Service Principal pour la production
# 3. SÉCURITÉ: Ne committez jamais vos vrais secrets dans Git
#
# 📋 POUR OBTENIR VOS IDENTIFIANTS:
# - Service Principal: Console Databricks > Settings > Service Principals
# - AgentBricks: Model Serving > Endpoints > Votre endpoint
