{
  "datasets": [
    {
      "name": "0e3d232f",
      "displayName": "Glucose Timeline",
      "queryLines": [
        "SELECT\r\n",
        "    patient_id,\r\n",
        "    event_time,\r\n",
        "    glucose_mmol_l,\r\n",
        "    source_id\r\n",
        "FROM dcp_synth.`04_presentation`.vw_glucose_timeline;"
      ]
    },
    {
      "name": "ea83eafe",
      "displayName": "Glucose Daily Summary",
      "queryLines": [
        "SELECT\r\n",
        "    patient_id,\r\n",
        "    measure_date,\r\n",
        "    mean_glucose_mmol_l,\r\n",
        "    tir_pct,\r\n",
        "    tbr_pct,\r\n",
        "    tar_pct,\r\n",
        "    reading_count,\r\n",
        "    refreshed_at\r\n",
        "FROM dcp_synth.`04_presentation`.vw_glucose_daily_summary\n",
        "ORDER BY measure_date DESC;"
      ]
    },
    {
      "name": "2d262e71",
      "displayName": "Glucose Range Distribution",
      "queryLines": [
        "SELECT patient_id, measure_date, 'TIR' AS range_category, tir_pct AS percentage\r\n",
        "FROM dcp_synth.`04_presentation`.vw_glucose_daily_summary\r\n",
        "UNION ALL\r\n",
        "SELECT patient_id, measure_date, 'TBR', tbr_pct\r\n",
        "FROM dcp_synth.`04_presentation`.vw_glucose_daily_summary\r\n",
        "UNION ALL\r\n",
        "SELECT patient_id, measure_date, 'TAR', tar_pct\r\n",
        "FROM dcp_synth.`04_presentation`.vw_glucose_daily_summary;"
      ]
    }
  ],
