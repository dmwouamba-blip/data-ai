{
  "datasets": [
    {
      "name": "patient_alerts",
      "displayName": "Patient Alerts",
      "queryLines": [
        "SELECT  alert_type,  status,  COUNT(*) AS alert_count\r\n",
        "FROM dcp_synth.`04_presentation`.vw_patient_alerts\r\n",
        "GROUP BY alert_type, status"
      ]
    },
    {
      "name": "report_sharing",
      "displayName": "Report Sharing",
      "queryLines": [
        "SELECT  recipient_type,  sharing_status,  COUNT(*) AS sharing_count\r\n",
        "FROM dcp_synth.`04_presentation`.vw_patient_report_sharing\r\n",
        "GROUP BY recipient_type, sharing_status"
      ]
    },
    {
      "name": "consent_current",
      "displayName": "Consent Current State",
      "queryLines": [
        "SELECT  consent_scope,  purpose,  recipient,  current_state,  patient_scope_count,  latest_effective_at\r\n",
        "FROM dcp_synth.`04_presentation`.vw_consent_current_summary"
      ]
    },
    {
      "name": "consent_propagation",
      "displayName": "Consent Propagation",
      "queryLines": [
        "SELECT  target_system,  target_status,  propagation_count,  refreshed_at\r\n",
        "FROM dcp_synth.`04_presentation`.vw_consent_propagation_summary"
      ]
    }
  ],
