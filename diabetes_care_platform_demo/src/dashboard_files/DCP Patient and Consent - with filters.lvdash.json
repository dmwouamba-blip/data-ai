{
  "datasets": [
    {
      "name": "patient_alerts",
      "displayName": "Patient Alerts",
      "queryLines": [
        "SELECT\n",
        "  INITCAP(REPLACE(alert_type, '_', ' ')) AS alert_type,\n",
        "  status,\n",
        "  COUNT(*) AS alert_count\n",
        "FROM\n",
        "  dcp_synth.`04_presentation`.vw_patient_alerts\n",
        "GROUP BY\n",
        "  alert_type,\n",
        "  status"
      ]
    },
    {
      "name": "report_sharing",
      "displayName": "Report Sharing",
      "queryLines": [
        "SELECT\n",
        "  INITCAP(REPLACE(recipient_type, '_', ' ')) AS recipient_type,\n",
        "  sharing_status,\n",
        "  COUNT(*) AS sharing_count\n",
        "FROM\n",
        "  dcp_synth.`04_presentation`.vw_patient_report_sharing\n",
        "GROUP BY\n",
        "  recipient_type,\n",
        "  sharing_status"
      ]
    },
    {
      "name": "consent_current",
      "displayName": "Consent Current State",
      "queryLines": [
        "SELECT\n",
        "  INITCAP(REPLACE(consent_scope, '_', ' ')) AS consent_scope,\n",
        "  purpose,\n",
        "  recipient,\n",
        "  current_state,\n",
        "  patient_scope_count,\n",
        "  latest_effective_at\n",
        "FROM\n",
        "  dcp_synth.`04_presentation`.vw_consent_current_summary"
      ]
    },
    {
      "name": "consent_propagation",
      "displayName": "Consent Propagation",
      "queryLines": [
        "SELECT\n",
        "  INITCAP(REPLACE(target_system, '_', ' ')) AS target_system,\n",
        "  target_status,\n",
        "  propagation_count,\n",
        "  refreshed_at\n",
        "FROM\n",
        "  dcp_synth.`04_presentation`.vw_consent_propagation_summary"
      ]
    }
  ],
