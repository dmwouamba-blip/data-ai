  "datasets": [
    {
      "name": "9fbaf3a4",
      "displayName": "Source Health dataset",
      "queryLines": [
        "SELECT source_id, source_name, domain, freshness_minutes, freshness_status, lifecycle_status\r\n",
        "FROM dcp_synth.`04_presentation`.vw_platform_source_health;"
